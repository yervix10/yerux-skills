#!/usr/bin/env bash
# agent update [--check] [--json] [--yes]  — look for a newer tagged release of yerux-skills and install it.
#   agent update --check   compares the installed version with the newest vX.Y.Z tag on GitHub (no changes)
#   agent update --yes     downloads that tag and runs the installer on it (asks for confirmation without --yes)
# Env: AGENT_BRIDGE_REPO=owner/repo (default yervix10/yerux-skills) · AGENT_BRIDGE_TAGS_FILE=<json> (offline tests)
set -eo pipefail
B="${BRIDGE_DIR:-$HOME/.claude-bridge}"; REPO="${AGENT_BRIDGE_REPO:-yervix10/yerux-skills}"
CHECK=0; JSON=0; YES=0
for a in "$@"; do case "$a" in --check) CHECK=1;; --json) JSON=1;; --yes|-y) YES=1;; -h|--help) sed -n 2,6p "$0"; exit 0;; *) echo "unknown option: $a" >&2; exit 2;; esac; done
installed="$(tr -d '[:space:]v' < "$B/version" 2>/dev/null || true)"; [ -n "$installed" ] || installed="0.0.0"
# Fetch the tag list with a conditional request (ETag): a 304 costs no GitHub rate limit, so checking every minute is cheap.
# After a 403/429 we stay quiet until X-RateLimit-Reset and keep serving the cached list. One cache shared by the widget, the CLI and listeners.
tags_json() { if [ -n "${AGENT_BRIDGE_TAGS_FILE:-}" ]; then cat "$AGENT_BRIDGE_TAGS_FILE"; return; fi
  command -v curl >/dev/null || { echo "missing: curl" >&2; return 1; }
  local cache="$B/update.tags.json" now hdr body code etag="" reset; now="$(date +%s)"; mkdir -p "$B"
  cached() { [ -s "$cache" ] && cat "$cache"; }
  if [ -f "$B/update.backoff" ] && [ "$now" -lt "$(cat "$B/update.backoff" 2>/dev/null || echo 0)" ] 2>/dev/null; then cached; return; fi
  [ -s "$cache" ] && [ -s "$B/update.etag" ] && etag="$(cat "$B/update.etag")"
  hdr="$(mktemp)"; body="$(mktemp)"
  code="$(curl -sS --max-time 15 -o "$body" -D "$hdr" -w '%{http_code}' -H 'Accept: application/vnd.github+json' ${etag:+-H "If-None-Match: $etag"} "https://api.github.com/repos/$REPO/tags?per_page=100" 2>/dev/null)" || code=000
  case "$code" in
    200) sed -n 's/^[Ee][Tt]ag: *//p' "$hdr" | tr -d '\r' > "$B/update.etag"; mv "$body" "$cache"; rm -f "$B/update.backoff"; cat "$cache";;
    304) cached;;
    403|429) reset="$(sed -n 's/^[Xx]-[Rr]ate[Ll]imit-[Rr]eset: *//p' "$hdr" | tr -d '\r\n')"; case "$reset" in ""|*[!0-9]*) reset=$((now + 900));; esac
             echo "$reset" > "$B/update.backoff"; cached;;
    *) cached;;
  esac; local rc=$?; rm -f "$hdr" "$body" 2>/dev/null; return $rc; }
latest_tag() { tags_json | grep -o '"name": *"v[0-9]\{1,4\}\.[0-9]\{1,4\}\.[0-9]\{1,4\}"' | sed 's/.*"\(v[^"]*\)"/\1/' | sort -V | tail -1; }
newer() { [ "$1" != "$2" ] && [ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | tail -1)" = "$1" ]; } # is $1 newer than $2
if [ $CHECK = 1 ] && [ -z "${AGENT_BRIDGE_TAGS_FILE:-}" ] && [ -f "$B/update.json" ]; then
  _ts="$(sed -n 's/.*"checked":\([0-9]*\).*/\1/p' "$B/update.json")"; _in="$(sed -n 's/.*"installed":"\([^"]*\)".*/\1/p' "$B/update.json")"
  if [ -n "$_ts" ] && [ "$_in" = "$installed" ] && [ $(( $(date +%s) - _ts )) -lt 45 ]; then
    if [ $JSON = 1 ]; then cat "$B/update.json"; else echo "checked moments ago; see $B/update.json"; fi; exit 0; fi
fi
tag="$(latest_tag || true)"; latest="${tag#v}"
available=0; [ -n "$latest" ] && newer "$latest" "$installed" && available=1
mkdir -p "$B"; printf '{"installed":"%s","latest":"%s","available":%s,"checked":%s}\n' "$installed" "${latest:-}" "$([ $available = 1 ] && echo true || echo false)" "$(date +%s)" > "$B/update.json.tmp" && mv "$B/update.json.tmp" "$B/update.json"
if [ -z "$tag" ]; then [ $JSON = 1 ] && cat "$B/update.json" || echo "could not read the releases of $REPO (offline, or no vX.Y.Z tags yet); installed: v$installed"; [ $CHECK = 1 ] && exit 0 || exit 1; fi
if [ $CHECK = 1 ]; then
  if [ $JSON = 1 ]; then cat "$B/update.json"
  elif [ $available = 1 ]; then echo "update available: v$installed -> $tag  (run: agent update --yes)"; else echo "up to date: v$installed"; fi; exit 0; fi
[ $available = 1 ] || { echo "already up to date (v$installed)"; exit 0; }
if [ $YES = 0 ]; then
  [ -t 0 ] || { echo "update available ($tag); run 'agent update --yes' to install it" >&2; exit 1; }
  printf 'Update v%s -> %s from github.com/%s? [y/N] ' "$installed" "$tag" "$REPO"; read -r ans; case "$ans" in [Yy]*) ;; *) echo cancelled; exit 1;; esac; fi
command -v curl >/dev/null || { echo "missing: curl" >&2; exit 1; }
echo "installing $tag ..."
curl -fsSL "https://raw.githubusercontent.com/$REPO/$tag/get.sh" | AGENT_BRIDGE_REF="$tag" AGENT_BRIDGE_REPO="$REPO" bash -s -- --yes
printf '%s\n' "$latest" > "$B/version"
# restart the widget on the new code (no-op when it was not running)
if [ -x "$B/bin/bridge-widget" ] && "$B/bin/bridge-widget" status 2>/dev/null | grep -qi activo; then "$B/bin/bridge-widget" stop >/dev/null 2>&1 || true; sleep 1; ( "$B/bin/bridge-widget" start --quiet & ) >/dev/null 2>&1; fi
# running runners keep the OLD code in memory: restart the idle ones on the new version; busy ones are listed (restarting would kill their task)
if [ -x "$B/bin/agent" ] && [ -d "$B/runs" ]; then
  busy=""
  for pf in "$B"/runs/*.pid; do [ -f "$pf" ] || continue; n="$(basename "$pf" .pid)"
    kill -0 "$(cat "$pf" 2>/dev/null)" 2>/dev/null || continue
    st="$(sed -n 's/^status=//p' "$B/runs/$n.state" 2>/dev/null | head -1)"
    if [ "$st" = working ]; then busy="$busy $n"; else "$B/bin/agent" down "$n" >/dev/null 2>&1 || true; sleep 1; "$B/bin/agent" up "$n" >/dev/null 2>&1 && echo "restarted $n on the new version"; fi
  done
  [ -z "$busy" ] || echo "still on the old version (working now):$busy  -> when idle: agent down <name>; agent up <name>"
fi
echo "updated to $tag"
