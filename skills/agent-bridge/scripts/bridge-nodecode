#!/usr/bin/env bash
# bridge-nodecode: run ONE order on Nodecode (`nodecode rpc`, JSON lines) and print the assistant's reply.
# usage: bridge-nodecode <prompt> [session-id] [model]
# The raw frames go to stdout's sibling file $BRIDGE_NODECODE_LIVE (if set) so the runner can show activity;
# the reply text goes to stdout; the session id (to resume the conversation next time) is printed on the LAST line as
#   @@session=<id>
# Exit codes: 0 ok, 1 turn failed / no answer, 124 timeout (BRIDGE_NODECODE_TIMEOUT seconds, default 3600, 0 = no limit).
set -u
prompt="${1:?prompt}"; sid="${2:-}"; model="${3:-}"
bin="$(command -v nodecode || echo "$HOME/.local/bin/nodecode")"; [ -x "$bin" ] || { echo "nodecode is not installed (curl -fsSL https://nodecode.ai/install.sh | sh)" >&2; exit 1; }
live="${BRIDGE_NODECODE_LIVE:-$(mktemp)}"; : > "$live"
dir="$(mktemp -d)"; fifo="$dir/in"; mkfifo "$fifo"
cleanup() { [ -n "${pid:-}" ] && kill "$pid" 2>/dev/null; exec 3>&- 2>/dev/null; rm -rf "$dir"; [ -z "${BRIDGE_NODECODE_LIVE:-}" ] && rm -f "$live"; }
trap cleanup EXIT
args=(rpc); [ -n "$sid" ] && args+=("$sid")
"$bin" "${args[@]}" < "$fifo" > "$live" 2> "$dir/err" & pid=$!
exec 3> "$fifo"
cmd="$(jq -nc --arg p "$prompt" --arg m "$model" '{type:"start_turn",request:({prompt:$p}+(if $m=="" then {} else {model:$m} end))}')"
printf '%s\n' "$cmd" >&3
limit="${BRIDGE_NODECODE_TIMEOUT:-3600}"; t0=$(date +%s); rc=124
while kill -0 "$pid" 2>/dev/null; do
  end="$(jq -r 'select(.payload.frame.event.type=="turn.completed" or .payload.frame.event.type=="turn.failed" or .payload.frame.event.type=="turn.cancelled")|.payload.frame.event.type' "$live" 2>/dev/null | tail -1)"
  rej="$(jq -r 'select(.payload.type=="gateway_turn_command_result" and .payload.result.status!="accepted")|.payload.result.message // "command rejected"' "$live" 2>/dev/null | tail -1)"
  [ -n "$end" ] && { [ "$end" = turn.completed ] && rc=0 || rc=1; break; }
  [ -n "$rej" ] && { echo "nodecode rejected the order: $rej" ; rc=1; break; }
  [ "$limit" -gt 0 ] && [ $(( $(date +%s) - t0 )) -ge "$limit" ] && { echo "nodecode order timed out after ${limit}s"; rc=124; break; }
  sleep 1
done
[ "$rc" = 124 ] && ! kill -0 "$pid" 2>/dev/null && { rc=1; echo "nodecode exited early: $(head -c 500 "$dir/err")"; }
text="$(jq -r 'select(.payload.frame.event.type=="turn.assistant_message_completed")|.payload.frame.event.payload.message.content // empty' "$live" 2>/dev/null | tail -1)"
[ "$rc" = 1 ] && [ -z "$text" ] && text="$(jq -r 'select(.payload.frame.event.type=="turn.failed")|(.payload.frame.event.payload|tostring)' "$live" 2>/dev/null | tail -1 | head -c 1500)"
[ -n "$text" ] && printf '%s\n' "$text"
id="$(jq -r '.session_id // empty' "$live" 2>/dev/null | head -1)"
[ -n "$id" ] && printf '@@session=%s\n' "$id"
exit "$rc"
