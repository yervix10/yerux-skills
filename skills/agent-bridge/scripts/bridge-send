#!/usr/bin/env bash
# bridge-send <target|all> "message"  |  --list
AB_SELF="$0"; while [ -L "$AB_SELF" ]; do AB_L="$(readlink "$AB_SELF")"; case "$AB_L" in /*) AB_SELF="$AB_L";; *) AB_SELF="$(dirname "$AB_SELF")/$AB_L";; esac; done; AB_DIR="$(cd "$(dirname "$AB_SELF")" && pwd)"  # resolve symlinks: ~/.local/bin/agent -> ~/.claude-bridge/bin/agent -> app
D="$AB_DIR"; B="${BRIDGE_DIR:-$HOME/.claude-bridge}"
if [ "$1" = "--list" ]; then ls "$B/inbox"; exit 0; fi
to="$1"; shift; msg="${*:-$(cat)}"
[[ "$to" =~ ^[A-Za-z0-9_-]+$ ]] || { echo "invalid target" >&2; exit 1; }
[ -n "$msg" ] || { echo "usage: bridge-send <target|all> \"message\"" >&2; exit 1; }
from="$("$D/bridge-whoami")"; from="${from:-unknown}"
if [ "$to" = all ]; then for t in $(ls "$B/inbox"); do [ "$t" = "$from" ] || "$0" "$t" "$msg"; done; exit 0; fi
mkdir -p "$B/inbox/$to"
f="$B/inbox/$to/$(date +%Y%m%dT%H%M%S).$$-de-$from.msg"
printf 'From: %s\nTo: %s\nDate: %s\nCwd: %s\n\n%s\n' "$from" "$to" "$(date '+%F %T')" "$PWD" "$msg" > "$f.tmp" && mv "$f.tmp" "$f"
echo "sent to $to"
