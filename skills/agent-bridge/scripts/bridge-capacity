#!/usr/bin/env bash
# bridge-capacity [--apply] [--tier <name>]: how much work each worker can take, from its 5h / weekly / monthly limits.
#   (no args)      table: remaining % per window, binding window, tier (skip|light|normal|heavy), share of the load, model + effort
#   --apply        (admin only) sets that recommended model/effort on every worker that is not "skip"
#   --tier <name>  prints just the tier of one worker (used by `agent <worker> ...` to warn the admin)
# Tier = from the tightest window: <=5% left skip, <=20% light, <=50% normal, else heavy. A weekly/monthly window being burnt faster
# than time passes (used% > elapsed% + 15) drops one tier. Claude workers always get sonnet (never opus); only the effort changes with the tier.
D="$(dirname "$0")"; B="${BRIDGE_DIR:-$HOME/.claude-bridge}"; me="$("$D/bridge-whoami")"; admin="$(cat "$B/admin" 2>/dev/null)"
now=$(date +%s); apply=0; only=""
case "$1" in --apply) apply=1;; --tier) only="$2";; esac
[ "$apply" = 1 ] && [ "$me" != "$admin" ] && { echo "only the admin can apply (you are $me)" >&2; exit 1; }
fmt() { local s=$(( $1 - now )); [ -z "$1" ] || [ $s -le 0 ] && return 0
  if [ $s -ge 86400 ]; then printf '%dd%dh' $((s / 86400)) $((s % 86400 / 3600)); elif [ $s -ge 3600 ]; then printf '%dh%02dm' $((s / 3600)) $((s % 3600 / 60)); else printf '%dm' $(( (s + 59) / 60 )); fi; }
lbl() { case "$1" in h5) echo 5h;; wk) echo semana;; mo) echo mes;; esac; }
declare -A TIER REM NOTE MODEL EFF KIND WIN
names=(); total=0
for n in $(awk -F= '{print $2}' "$B/names.conf"); do
  [ "$n" = "$admin" ] && continue; [ -n "$only" ] && [ "$n" != "$only" ] && continue
  dir="$(awk -F= -v n="$n" '$2==n{print $1; exit}' "$B/names.conf")"; k="$("$D/bridge-provider" "$dir" 2>/dev/null || echo codex)"
  IFS=$'\t' read -r _ _ _ ctx h5 wk _ _ h5r wkr mo mor _ _ _ _ _ < <("$D/bridge-usage" "$n" 2>/dev/null)
  for v in ctx h5 wk h5r wkr mo mor; do [ "${!v}" = - ] && printf -v "$v" ''; done
  for v in h5 wk mo; do raw="${!v}"; [[ "$raw" == *.* ]] && printf -v "$v" '%s' "${raw%%.*}"; done
  best=101; bw=""; bwr=""; penal=0; ontrack=1; any=0
  for w in h5:18000:$h5:$h5r wk:604800:$wk:$wkr mo:2592000:$mo:$mor; do IFS=: read -r wn len p r <<< "$w"; [ -n "$p" ] || continue; any=1
    rem=$((100 - p)); [ $rem -lt 0 ] && rem=0
    if [ -n "$r" ] && [ "$r" -gt "$now" ] 2>/dev/null && [ "$wn" != h5 ]; then el=$(( (len - (r - now)) * 100 / len )); [ $((p - el)) -gt 15 ] && penal=1; [ $((p - el)) -gt 0 ] && ontrack=0; fi
    [ "$wn" != h5 ] && [ -z "$r" ] && ontrack=0
    [ $rem -lt $best ] && { best=$rem; bw=$wn; bwr=$r; }; done
  if [ $any = 0 ]; then t=normal; best=50; note="sin datos de límite"; else
    if [ $best -le 5 ]; then t=skip; elif [ $best -le 20 ]; then t=light; elif [ $best -le 50 ]; then t=normal; else t=heavy; fi
    if [ $penal = 1 ]; then case $t in heavy) t=normal;; normal) t=light;; esac; note="ritmo alto en $(lbl "$bw")"; else note=""; fi
    [ -n "$bwr" ] && note="${note:+$note; }límite $(lbl "$bw") ↻$(fmt "$bwr")"; fi
  [ "$t" = skip ] && note="no asignar; $note"
  [ -n "$ctx" ] && [ "$ctx" -ge "$(sed -n 's/^COMPACT_AT=//p' "$B/config" 2>/dev/null | head -1 | grep -E '^[1-9][0-9]*$' || echo 40)" ] && note="${note:+$note; }ctx ${ctx}% (compactará)"
  [ "$k" = copilot ] && { t=light; note="${note:+$note; }cada orden gasta premium requests"; }   # monthly premium-request quota: keep it for short tasks
  m="-"; e="-"
  if [ "$k" = claude ]; then case $t in light) m=sonnet; e=low;; normal) m=sonnet; e=medium;; heavy) m=sonnet; e=high;; esac   # Claude always runs sonnet (balanced for day-to-day work), never opus
  elif [ "$k" = cursor ] || [ "$k" = opencode ] || [ "$k" = copilot ]; then m="($k)"; e="-"   # no effort flag: only the tier is advised
  elif [ "$k" = antigravity ]; then m="(Antigravity)"; case $t in light) e=low;; normal) e=medium;; heavy) e=high;; esac
  elif [ "$k" = kiro ]; then m="(Kiro)"; case $t in light) e=low;; normal) e=medium;; heavy) e=high;; esac
  else case $t in light) e=low;; normal) e=medium;; heavy) e=medium; [ $best -ge 80 ] && [ $ontrack = 1 ] && e=high;; esac; m="(su modelo)"; fi
  TIER[$n]=$t; REM[$n]=$best; NOTE[$n]=$note; MODEL[$n]=$m; EFF[$n]=$e; KIND[$n]=$k; names+=("$n"); [ "$t" != skip ] && total=$((total + best))
done
[ -n "$only" ] && { echo "${TIER[$only]:-normal}"; exit 0; }
printf '%-9s %-7s %-6s %-6s %-12s %-7s %s\n' agente tier resta carga modelo esfuerzo nota
for n in "${names[@]}"; do share="-"; [ "${TIER[$n]}" != skip ] && [ $total -gt 0 ] && share="$(( ${REM[$n]} * 100 / total ))%"
  printf '%-9s %-7s %-6s %-6s %-12s %-7s %s\n' "$n" "${TIER[$n]}" "${REM[$n]}%" "$share" "${MODEL[$n]}" "${EFF[$n]}" "${NOTE[$n]}"; done
echo; echo "tiers: heavy = tareas grandes/difíciles · normal = tareas medianas · light = solo tareas cortas · skip = no asignar hasta el reinicio. 'carga' = reparto sugerido del trabajo."
if [ $apply = 1 ]; then echo; for n in "${names[@]}"; do [ "${TIER[$n]}" = skip ] && { echo "$n: sin cambios (skip)"; continue; }
    if [ "${KIND[$n]}" = claude ]; then "$D/agent" model "$n" "${MODEL[$n]}" "${EFF[$n]}"; elif [ "${KIND[$n]}" = cursor ] || [ "${KIND[$n]}" = opencode ] || [ "${KIND[$n]}" = copilot ]; then echo "$n: sin cambios (${KIND[$n]} no tiene esfuerzo configurable)"; elif [ "${KIND[$n]}" = kiro ]; then "$D/agent" effort "$n" "${EFF[$n]}"; else "$D/agent" effort "$n" "${EFF[$n]}"; fi; done; fi
