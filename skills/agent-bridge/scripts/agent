#!/usr/bin/env bash
# agent ping <target> | agent <target> <message...> | agent list | agent inbox | agent listen | agent up/down/status/logs/reset
AB_SELF="$0"; while [ -L "$AB_SELF" ]; do AB_L="$(readlink "$AB_SELF")"; case "$AB_L" in /*) AB_SELF="$AB_L";; *) AB_SELF="$(dirname "$AB_SELF")/$AB_L";; esac; done; AB_DIR="$(cd "$(dirname "$AB_SELF")" && pwd)"  # resolve symlinks: ~/.local/bin/agent -> ~/.claude-bridge/bin/agent -> app
D="$AB_DIR"; R="${BRIDGE_DIR:-$HOME/.claude-bridge}"; me="$("$D/bridge-whoami")"
dashboard_tier() {
  local now="$1" h5="$2" wk="$3" mo="$4" h5r="$5" wkr="$6" mor="$7" best=101 penal=0 any=0 p r wn len rem tier
  for item in "h5:18000:$h5:$h5r" "wk:604800:$wk:$wkr" "mo:2592000:$mo:$mor"; do
    IFS=: read -r wn len p r <<< "$item"; [ -n "$p" ] || continue; p="${p%.*}"; case "$p" in *[!0-9]*) continue;; esac; any=1
    rem=$((100 - p)); [ "$rem" -lt 0 ] && rem=0; [ "$rem" -lt "$best" ] && best="$rem"
    if [ "$wn" != h5 ] && [ -n "$r" ] && [ "$r" -gt "$now" ] 2>/dev/null; then
      el=$(( (len - (r - now)) * 100 / len )); [ $((p - el)) -gt 15 ] && penal=1
    fi
  done
  [ "$any" = 1 ] || { echo normal; return; }
  if [ "$best" -le 5 ]; then tier=skip; elif [ "$best" -le 20 ]; then tier=light; elif [ "$best" -le 50 ]; then tier=normal; else tier=heavy; fi
  if [ "$penal" = 1 ]; then case "$tier" in heavy) tier=normal;; normal) tier=light;; esac; fi
  echo "$tier"
}
case "$1" in
  feed) shift; exec "$D/bridge-feed" "$@";;
  ping) [ -n "$2" ] || { echo "usage: agent ping <target>" >&2; exit 1; }
        "$D/bridge-send" "$2" "ping from $me ($(date +%T))" ;;
  admin) shift; exec "$D/admin" "$@";;
  update) shift; exec "$D/agent-update" "$@";;
  up) shift; names=("$@"); [ "$1" = all ] && names=($(awk -F= '{print $2}' "$R/names.conf")); 
      for n in "${names[@]}"; do [ "$n" = "$me" ] && continue
        [ -e "$R/disabled/$n" ] && { echo "$n: disabled (agent enable $n to use it)"; continue; }
        if [ -f "$R/runs/$n.pid" ] && kill -0 "$(cat "$R/runs/$n.pid")" 2>/dev/null; then echo "$n: already up"; continue; fi
        mkdir -p "$R/runs" "$R/logs"; if command -v setsid >/dev/null 2>&1; then setsid nohup "$D/bridge-runner" "$n" >/dev/null 2>&1 < /dev/null & else nohup "$D/bridge-runner" "$n" >/dev/null 2>&1 < /dev/null & fi; echo $! > "$R/runs/$n.pid"; echo "$n: up (pid $!)"; done
      # the desktop widget starts with the workers (idempotent; WIDGET=0 in ~/.claude-bridge/config or BRIDGE_WIDGET=0 disables it)
      [ "${BRIDGE_WIDGET:-$(sed -n 's/^WIDGET=//p' "$R/config" 2>/dev/null | head -1)}" = 0 ] || [ ! -x "$D/bridge-widget" ] || ( "$D/bridge-widget" start --quiet & ) >/dev/null 2>&1;;
  down) shift; names=("$@"); [ "$1" = all ] && names=($(ls "$R/runs" 2>/dev/null | sed -n 's/\.pid$//p'))
      for n in "${names[@]}"; do p="$(cat "$R/runs/$n.pid" 2>/dev/null)"; [ -n "$p" ] && kill "$p" 2>/dev/null && echo "$n: stopped" || echo "$n: was not up"; rm -f "$R/runs/$n.pid"; done;;
  disable|enable) cmd="$1"; shift; n="$1"; adm="$(cat "$R/admin" 2>/dev/null)"
      [ "$me" = "$adm" ] || { echo "only the admin can $cmd a worker (you are $me)" >&2; exit 1; }
      [ -n "$n" ] && awk -F= -v n="$n" '$2==n{found=1} END{exit !found}' "$R/names.conf" || { echo "usage: agent $cmd <worker>   (unknown or missing worker: $n)" >&2; exit 1; }
      [ "$n" != "$adm" ] || { echo "the admin cannot be ${cmd}d" >&2; exit 1; }
      mkdir -p "$R/disabled"
      if [ "$cmd" = disable ]; then : > "$R/disabled/$n"; "$0" down "$n" >/dev/null 2>&1; echo "$n: disabled (runner stopped; the admin cannot send it orders until: agent enable $n)"
      else rm -f "$R/disabled/$n"; echo "$n: enabled (start it with: agent up $n)"; fi;;
  status) now=$(date +%s); for n in $(awk -F= '{print $2}' "$R/names.conf"); do
      if [ -e "$R/disabled/$n" ]; then echo "$n: DISABLED (blocked; agent enable $n)"; continue; fi
      if [ -f "$R/runs/$n.pid" ] && kill -0 "$(cat "$R/runs/$n.pid")" 2>/dev/null; then
        sf="$R/runs/$n.state"; g() { sed -n "s/^$1=//p" "$sf" 2>/dev/null | head -1; }
        st="$(g status)"; since="$(g since)"; beat="$(g beat)"; line="$n: UP"
        if [ -z "$st" ]; then line="$line  (no state yet: restart it with agent down/up $n)"
        elif [ -n "$beat" ] && [ $((now - beat)) -gt 120 ]; then line="$line  NO HEARTBEAT for $(( (now - beat) / 60 )) min: the runner looks stuck (agent down $n; agent up $n)"
        elif [ "$st" = limited ]; then pu="$(g pause_until)"; line="$line  LIMITED, paused until $(date -d "@$pu" +%H:%M 2>/dev/null || date -r "$pu" +%H:%M)"
        elif [ "$st" = working ]; then el=$((now - since)); line="$line  WORKING $([ $el -ge 120 ] && echo "$((el / 60)) min" || echo "${el}s")  ($(g order))"
          ac="$(g activity)"; aa="$(g activity_at)"; [ -n "$ac" ] && line="$line  now: $ac [$(( (now - aa) ))s ago]"
        else line="$line  idle"; lk="$(g last_kind)"; le="$(g last_end)"
          [ -n "$lk" ] && line="$line · last order: $lk ($(date -d "@$le" +%H:%M 2>/dev/null || date -r "$le" +%H:%M 2>/dev/null))"; fi
        echo "$line"
      else echo "$n: -"; fi; done;;
  wt) shift; sub="${1:-list}"; wn="$2"; root="$(git rev-parse --show-toplevel 2>/dev/null)" || { echo "agent wt: run it inside a git project" >&2; exit 1; }
      root="$(cd "$root" && cd "$(git rev-parse --git-common-dir)/.." && pwd)"; yes=0; for a in "$@"; do [ "$a" = --yes ] && yes=1; done
      case "$sub" in
        list) found=0; for d in "$root"/.worktrees/*/; do [ -d "$d" ] || continue; found=1; w="$(basename "$d")"; br="$(git -C "$d" rev-parse --abbrev-ref HEAD 2>/dev/null)"
            base="$(git -C "$root" rev-parse --abbrev-ref HEAD)"; ahead="$(git -C "$root" rev-list --count "$base..$br" 2>/dev/null)"; dirty="$(git -C "$d" status --short | wc -l | tr -d ' ')"
            echo "$w: branch $br, $ahead commit(s) ahead of $base, $dirty uncommitted file(s)"; done; [ $found = 0 ] && echo "no worktrees in $root/.worktrees";;
        diff) [ -n "$wn" ] || { echo "usage: agent wt diff <name>" >&2; exit 1; }; git -C "$root" diff --stat "HEAD...mejora/$wn";;
        merge) [ -n "$wn" ] || { echo "usage: agent wt merge <name> [--yes]" >&2; exit 1; }; d="$root/.worktrees/$wn"
            [ -d "$d" ] || { echo "no worktree for $wn" >&2; exit 1; }
            [ -z "$(git -C "$d" status --short)" ] || { echo "$wn has uncommitted changes; ask it to commit first" >&2; exit 1; }
            [ -z "$(git -C "$root" status --short --untracked-files=no)" ] || { echo "the main checkout has uncommitted changes; commit or stash them first" >&2; exit 1; }
            base="$(git -C "$root" rev-parse --abbrev-ref HEAD)"; echo "would merge mejora/$wn into $base:"; git -C "$root" log --oneline "$base..mejora/$wn"
            [ $yes = 1 ] || { echo "(add --yes to merge)"; exit 0; }; git -C "$root" merge --no-ff -m "Merge mejora/$wn" "mejora/$wn";;
        clean) [ -n "$wn" ] || { echo "usage: agent wt clean <name> [--yes]" >&2; exit 1; }; d="$root/.worktrees/$wn"
            [ $yes = 1 ] || { echo "would remove $d and delete branch mejora/$wn if it is merged (add --yes)"; exit 0; }
            git -C "$root" worktree remove "$d" && git -C "$root" branch -d "mejora/$wn";;
        *) echo "agent wt list | diff <name> | merge <name> [--yes] | clean <name> [--yes]" >&2; exit 1;;
      esac;;
  refresh) shift; names=("$@"); { [ -z "$1" ] || [ "$1" = all ]; } && names=($(awk -F= '{print $2}' "$R/names.conf"))
      # one tiny request per Claude account so the dashboard has fresh model / context / 5h / weekly numbers (costs a few tokens)
      for n in "${names[@]}"; do dir="$(awk -F= -v n="$n" '$2==n{print $1; exit}' "$R/names.conf")"
        case "$("$D/bridge-provider" "$dir" 2>/dev/null)" in claude) mkdir -p "$R/logs"
          ( cd "$HOME" && BRIDGE_NO_HOOK=1 BRIDGE_NAME="$n" CLAUDE_CONFIG_DIR="$dir" claude -p --no-session-persistence --output-format stream-json --verbose "Reply with exactly: ok" > "$R/logs/$n.probe.tmp" 2>/dev/null ) && mv "$R/logs/$n.probe.tmp" "$R/logs/$n.probe" && echo "$n: refreshed" || { rm -f "$R/logs/$n.probe.tmp"; echo "$n: failed (is claude logged in there?)"; };;
          antigravity) echo "$n: Antigravity data comes from its runner log, nothing to refresh";;
          cursor) echo "$n: Cursor data comes from its runner log, nothing to refresh";;
          opencode|copilot|nodecode) echo "$n: data comes from its runner log, nothing to refresh";;
          kiro) echo "$n: Kiro data comes from its sessions, nothing to refresh";;
          *) echo "$n: Codex data comes from its sessions, nothing to refresh";; esac; done;;
  dashboard) # live view (terminal) or --once: a single plain snapshot (what the admin's /dashboard prints)
      if [ "$2" = --json ]; then # machine-readable snapshot (what the desktop widget reads): {"time":epoch,"agents":[...]}
        st="$("$0" status)"; adm="$(cat "$R/admin" 2>/dev/null)"; now=$(date +%s); items=()
        for n in $(awk -F= '{print $2}' "$R/names.conf"); do
          IFS=$'\t' read -r model proj br ctx h5 wk age eff h5r wkr mo mor credits ctxwin plan_used plan_total plan < <("$D/bridge-usage" "$n" 2>/dev/null)
          for v in model proj br ctx h5 wk age eff h5r wkr mo mor credits ctxwin plan_used plan_total plan; do [ "${!v}" = - ] && printf -v "$v" ''; done
          line="$(printf '%s\n' "$st" | sed -n "s/^$n: *//p" | head -1)"; role=worker; [ "$n" = "$adm" ] && role=admin
          case "$line" in "") state=${role/worker/off}; [ "$role" = admin ] && state=admin;; "-"*) state=off;; *LIMITED*) state=limited;; *"NO HEARTBEAT"*) state=stuck;; *WORKING*) state=working;; *"last order: auth"*) state=auth;; *idle*) state=idle;; *) state=unknown;; esac
          [ "$role" = admin ] && state=admin
          disabled=false; [ "$role" = worker ] && [ -e "$R/disabled/$n" ] && { disabled=true; state=disabled; }
          want="$(cat "$R/models/$n" 2>/dev/null)"; weff="$(cat "$R/effort/$n" 2>/dev/null)"
          tier=""; [ "$role" = worker ] && tier="$(dashboard_tier "$now" "${h5:-}" "${wk:-}" "${mo:-}" "${h5r:-}" "${wkr:-}" "${mor:-}")"
          kind="$("$D/bridge-provider" "$n" 2>/dev/null || echo other)"
          model_note=""; [ "$kind" != kiro ] || [ "$model" != auto ] || model_note="Kiro elige el modelo según la tarea (Models chosen by task)."
          [ "$kind" = opencode ] && [ -n "$credits" ] && model_note="Coste acumulado: USD $(LC_ALL=C printf '%.4f' "$credits")"
          if [ "$kind" = copilot ]; then tier=light; [ -n "$credits" ] && model_note="Premium requests usados: $credits (cuota mensual)"; fi
          items+=("$(jq -n --argjson disabled "$disabled" --arg name "$n" --arg role "$role" --arg kind "$kind" --arg state "$state" --arg line "$line" --arg model "$model" --arg model_note "$model_note" --arg eff "$eff" --arg want "$want" --arg weff "$weff" --arg proj "$proj" --arg br "$br" --arg tier "$tier" --arg credits "$credits" --arg plan_used "$plan_used" --arg plan_total "$plan_total" --arg plan "$plan" \
            --arg ctx "$ctx" --arg h5 "$h5" --arg h5r "$h5r" --arg wk "$wk" --arg wkr "$wkr" --arg mo "$mo" --arg mor "$mor" --arg age "$age" \
            '{name:$name,role:$role,kind:$kind,state:$state,disabled:$disabled,detail:$line,model:$model,model_note:$model_note,effort:$eff,set_model:$want,set_effort:$weff,project:$proj,branch:$br,tier:$tier,credit_used:($credits|tonumber? // null),
              context:($ctx|tonumber? // null),data_age_s:($age|tonumber? // null),
              five_hour:{used:($h5|tonumber? // null),resets_at:($h5r|tonumber? // null)},
              weekly:{used:($wk|tonumber? // null),resets_at:($wkr|tonumber? // null)},
              monthly:{used:($mo|tonumber? // null),resets_at:($mor|tonumber? // null),credits_used:($plan_used|tonumber? // null),credits_total:($plan_total|tonumber? // null),plan:(if $plan=="" or $plan=="-" then null else $plan end)}}')"); done
        printf '%s\n' "${items[@]}" | jq -s --argjson t "$now" '{time:$t,agents:.}'; exit 0; fi
      once=0; [ "$2" = --once ] && once=1
      if [ $once = 0 ]; then trap 'printf "\033[?25h"; exit 0' INT TERM; printf '\033[?25l'; fi
      col() { [ $once = 0 ] && printf '\033[%sm' "$1"; return 0; }
      # left <epoch>: " (↻1h23m)" = time until that limit window resets (nothing when unknown)
      left() { [ -z "$1" ] && return 0; local s=$(( $1 - $(date +%s) )); [ $s -le 0 ] && return 0; col 2
        if [ $s -ge 86400 ]; then printf ' (↻%dd%dh)' $((s / 86400)) $((s % 86400 / 3600)); elif [ $s -ge 3600 ]; then printf ' (↻%dh%02dm)' $((s / 3600)) $((s % 3600 / 60)); else printf ' (↻%dm)' $(( (s + 59) / 60 )); fi; col 0; }
      pct() { case "$1" in *.*) set -- "${1%%.*}";; esac; case "$1" in ""|*[!0-9]*) col 2; printf '–'; col 0; return;; esac; c=32; [ "$1" -ge 60 ] && c=33; [ "$1" -ge 85 ] && c=31; col $c; printf '%s%%' "$1"; col 0; }
      while :; do
        if [ $once = 0 ]; then printf '\033[H\033[2J'; printf '\033[1magent-bridge\033[0m  %s   \033[2m(Ctrl+C to exit)\033[0m\n\n' "$(date +%T)"; else echo "agent-bridge  $(date +%T)"; echo; fi
        st="$("$0" status)"
        for n in $(awk -F= '{print $2}' "$R/names.conf"); do
          IFS=$'\t' read -r model proj br ctx h5 wk age eff h5r wkr mo mor credits ctxwin plan_used plan_total plan < <("$D/bridge-usage" "$n" 2>/dev/null)
          for v in model proj br ctx h5 wk age eff h5r wkr mo mor credits ctxwin plan_used plan_total plan; do [ "${!v}" = - ] && printf -v "$v" ''; done
          want="$(cat "$R/models/$n" 2>/dev/null)"; weff="$(cat "$R/effort/$n" 2>/dev/null)"
          state="$(printf '%s\n' "$st" | sed -n "s/^$n: *//p" | head -1)"
          col 1; printf '%-9s' "$n"; col 0; printf ' %s' "${model:-–}"; [ -n "$eff" ] && printf ' · %s' "$eff"; { [ -n "$want" ] || [ -n "$weff" ]; } && printf ' (set: %s)' "$(printf '%s %s' "${want:-}" "${weff:+effort $weff}" | sed 's/^ //; s/ $//')"
          printf ' | %s | %s | ctx ' "${proj:-–}" "${br:-–}"; pct "$ctx"; printf ' | 5h '; pct "$h5"; left "$h5r"; printf ' | sem '; pct "$wk"; left "$wkr"; [ -n "$mo" ] && { printf ' | mes '; pct "$mo"; left "$mor"; }
          [ -n "$credits" ] && LC_NUMERIC=C printf ' | %.2f cr' "$credits"
          [ -n "$age" ] && [ "$age" -gt 600 ] && { col 2; printf ' (data %s min old)' $((age / 60)); col 0; }
          printf '\n          '; col 2; printf '%s' "$state"; col 0; printf '\n'; done
        [ $once = 1 ] && break; sleep 2; done;;
  capacity) shift; exec "$D/bridge-capacity" "$@";;
  widget) shift; exec "$D/bridge-widget" "$@";;
  compact) n="$2"; adm="$(cat "$R/admin" 2>/dev/null)"
      [ "$me" = "$adm" ] || { echo "only the admin can compact a worker (you are $me)" >&2; exit 1; }
      [ -n "$n" ] && awk -F= -v n="$n" '$2==n{found=1} END{exit !found}' "$R/names.conf" || { echo "unknown worker: $n" >&2; exit 1; }
      [ "$n" != "$adm" ] || { echo "the admin is interactive; use /compact in its terminal" >&2; exit 1; }
      [ -f "$R/runs/$n.pid" ] && kill -0 "$(cat "$R/runs/$n.pid")" 2>/dev/null || { echo "$n: runner is not active; no session can be compacted now" >&2; exit 1; }
      state="$(sed -n 's/^status=//p' "$R/runs/$n.state" 2>/dev/null | head -1)"
      if [ "$state" = idle ]; then has_session=0; for sf in "$R/sessions/$n"/*; do case "$sf" in *.cwd) continue;; esac; [ -f "$sf" ] && { has_session=1; break; }; done
        [ "$has_session" = 1 ] || { echo "$n: no saved session to compact yet" >&2; exit 1; }; fi
      mkdir -p "$R/runs"; tmp="$R/runs/$n.compact.request.tmp.$$"; printf 'requested_at=%s\n' "$(date +%s)" > "$tmp" && mv "$tmp" "$R/runs/$n.compact.request" || exit 1
      echo "$n: compaction queued (starts now if idle, otherwise before its next order)";;
  model|effort) cmd="$1"; shift; n="$1"; v="$2"; f="$R/models"; [ "$cmd" = effort ] && f="$R/effort"
      if [ -z "$n" ]; then for w in $(awk -F= '{print $2}' "$R/names.conf"); do echo "$w: model $(cat "$R/models/$w" 2>/dev/null || echo default), effort $(cat "$R/effort/$w" 2>/dev/null || echo default)"; done; exit 0; fi
      [ "$me" = "$(cat "$R/admin" 2>/dev/null)" ] || { echo "only the admin can change a worker's $cmd (you are $me)" >&2; exit 1; }
      dir="$(awk -F= -v n="$n" '$2==n{print $1; exit}' "$R/names.conf")"; [ -n "$dir" ] || { echo "unknown worker: $n" >&2; exit 1; }
      [ -n "$v" ] || { echo "usage: agent $cmd <worker> <$([ "$cmd" = effort ] && echo level || echo model)|default>   e.g. agent model claude-2 claude-opus-5-5 high" >&2; exit 1; }
      kind="$("$D/bridge-provider" "$dir" 2>/dev/null || echo other)"
      setone() { local file="$1" val="$2" what="$3"
        if [ "$val" = default ]; then rm -f "$file"; echo "$n: $what back to its default (applies from its next order)"; return 0; fi
        if [ "$what" = effort ] && { [ "$kind" = cursor ] || [ "$kind" = opencode ] || [ "$kind" = nodecode ]; }; then echo "effort is not configurable for $kind workers (pick a model with the level built in, e.g. a *-high model)" >&2; return 1; fi
        if [ "$what" = effort ]; then case "$kind" in claude|kiro|antigravity) levels="low medium high xhigh max";; copilot) levels="low medium high xhigh";; *) levels="none minimal low medium high xhigh";; esac
          case " $levels " in *" $val "*) ;; *) echo "invalid effort for $kind: use one of $levels, or default" >&2; return 1;; esac
        else [[ "$val" =~ ^[][A-Za-z0-9._:/-]+$ ]] || { echo "invalid model name" >&2; return 1; }
          if [ "$kind" = kiro ] && { ! command -v kiro-cli >/dev/null 2>&1 || ! kiro-cli chat --list-models --format json 2>/dev/null | jq -e --arg m "$val" '.models[]|select(.model_id==$m)' >/dev/null; }; then echo "modelo Kiro desconocido o kiro-cli no disponible" >&2; return 1; fi
          if [ "$kind" = antigravity ] && { ! command -v agy >/dev/null 2>&1 || ! agy models 2>/dev/null | awk -F'\t' -v m="$val" '$1==m{f=1} END{exit !f}'; }; then echo "unknown Antigravity model or agy not available (see: agy models)" >&2; return 1; fi
          if [ "$kind" = opencode ]; then
            case "$val" in */*) ;; *) echo "OpenCode models are provider/model (see: opencode models)" >&2; return 1;; esac
            case "$val" in *-free|*:free) ;; *) [ "${BRIDGE_OPENCODE_PAID:-$(sed -n 's/^OPENCODE_PAID=//p' "$R/config" 2>/dev/null | head -1)}" = 1 ] || { echo "$val is not a free model: OpenCode workers accept only *-free / *:free models (set BRIDGE_OPENCODE_PAID=1 or OPENCODE_PAID=1 in ~/.claude-bridge/config to allow paid ones)" >&2; return 1; };; esac
            if ! command -v opencode >/dev/null 2>&1 || ! opencode models 2>/dev/null | grep -qxF "$val"; then echo "unknown OpenCode model or opencode not available (see: opencode models)" >&2; return 1; fi; fi
          if [ "$kind" = nodecode ] && ! command -v nodecode >/dev/null 2>&1 && [ ! -x "$HOME/.local/bin/nodecode" ]; then echo "nodecode is not installed" >&2; return 1; fi
          if [ "$kind" = cursor ] && { ! command -v cursor-agent >/dev/null 2>&1 || ! cursor-agent models 2>/dev/null | awk -v m="$val" '$1==m{f=1} END{exit !f}'; }; then echo "unknown Cursor model or cursor-agent not available (see: cursor-agent models)" >&2; return 1; fi; fi
        mkdir -p "$(dirname "$file")"; printf '%s' "$val" > "$file"; echo "$n: $what set to $val (applies from its next order)"; }
      if [ "$cmd" = model ]; then setone "$R/models/$n" "$v" model || exit 1; [ -n "$3" ] && { setone "$R/effort/$n" "$3" effort || exit 1; }
      else setone "$R/effort/$n" "$v" effort || exit 1; fi;;
  logs) [ -f "$R/runs/$2.state" ] && sed -n 's/^status=/status: /p;s/^order=/order: /p;s/^activity=/doing: /p;s/^last_kind=/last result: /p' "$R/runs/$2.state"; tail -n "${3:-30}" "$R/logs/$2.log";;
  reset) rm -rf "$R/sessions/$2" && echo "memory of $2 cleared";;
  list) "$D/bridge-send" --list ;;
  inbox) ls "${BRIDGE_DIR:-$HOME/.claude-bridge}/inbox/$me" 2>/dev/null | sed 's/^/pending: /'; echo "(end)" ;;
  listen) exec "$D/bridge-wait" ;;
  ""|-h|--help) echo "agent ping <target> | agent <target> <message> | agent all <message> | agent list | agent inbox | agent listen | agent up|down <name|all> | agent status | agent dashboard [--once|--json] | agent capacity [--apply] | agent widget [start|stop|status] | agent enable|disable <worker> | agent model <worker> <model|default> [effort] | agent effort <worker> <level|default> | agent compact <worker> | agent refresh [name|all] | agent logs <name> | agent reset <name> | agent wt list|diff|merge|clean <name> | agent admin [who|release]" ;;
  *) to="$1"; shift
     # the admin is warned when it sends work to a worker with little headroom (it is not blocked)
     if [ "$me" = "$(cat "$R/admin" 2>/dev/null)" ] && [ "$to" != all ] && [ "${#1}" -gt 40 ]; then t="$("$D/bridge-capacity" --tier "$to" 2>/dev/null)"
       case "$t" in skip) echo "WARNING: $to is at (almost) its usage limit (tier skip); run 'agent capacity' and consider another worker." >&2;; light) echo "NOTE: $to has little headroom (tier light): keep the order short or pick another worker ('agent capacity')." >&2;; esac; fi
     "$D/bridge-send" "$to" "$@" ;;
esac
