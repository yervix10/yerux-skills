#!/usr/bin/env bash
# bridge-kiro-response <stream-json>: reconstruct the complete current turn response.
set -o pipefail
file="${1:?usage: bridge-kiro-response <stream-json>}"
if [ ! -r "$file" ]; then exit 1; fi
# Kiro streams assistant text in fragments around tool calls. The runner truncates
# multiline strings if it tails jq's raw output, so join fragments before printing.
jq -srj '[.[] | select(.type=="sessionUpdate" and .data.update.sessionUpdate=="agent_message_chunk") | (.data.update.content.text // "") | select(gsub("^\\s+|\\s+$"; "") != "...")] | join("")' "$file" 2>/dev/null > "${TMPDIR:-/tmp}/bridge-kiro-response.$$"
if [ -s "${TMPDIR:-/tmp}/bridge-kiro-response.$$" ]; then
  cat "${TMPDIR:-/tmp}/bridge-kiro-response.$$"
  rm -f "${TMPDIR:-/tmp}/bridge-kiro-response.$$"
  exit 0
fi
rm -f "${TMPDIR:-/tmp}/bridge-kiro-response.$$"
# Older CLI builds may only emit runFinished.finalText.
jq -srj '[.[] | select(.type=="runFinished") | .data.finalText // empty] | last // ""' "$file" 2>/dev/null
