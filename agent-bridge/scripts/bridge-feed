#!/usr/bin/env node
'use strict';
const fs = require('node:fs');
const path = require('node:path');
const os = require('node:os');

const trunc = (s) => redact(String(s || '')).slice(0, 2000);
const printable = (value) => typeof value === 'string' ? value : value === undefined || value === null ? '' : JSON.stringify(value);
const textValue = (value) => typeof value === 'string' ? value : Array.isArray(value) ? value.map(textValue).filter(Boolean).join('\n') : value && typeof value === 'object' && typeof value.text === 'string' ? value.text : '';
function cleanOrder(value) {
  let text = String(value || '').trim();
  const marker = /(?:^|\n)Order:\s*\n/;
  const found = text.match(marker);
  if (found) text = text.slice(found.index + found[0].length).trim();
  if (/^#\s*AGENTS\.md instructions\b/i.test(text)) {
    const end = text.search(/<environment_context>/i);
    const close = text.search(/<\/environment_context>/i);
    if (end >= 0 && close >= end) text = text.slice(close + '</environment_context>'.length).trim();
    else return '';
  }
  if (/^<environment_context>/i.test(text)) {
    const close = text.search(/<\/environment_context>/i);
    if (close < 0) return '';
    text = text.slice(close + '</environment_context>'.length).trim();
  }
  if (/^Order:\s*$/m.test(text)) text = text.replace(/^Order:\s*$/m, '').trim();
  if (!text || /^#\s*AGENTS\.md instructions\b/i.test(text)) return '';
  return text;
}
function redact(s) {
  return s.replace(/-----BEGIN [^-]*PRIVATE KEY-----[\s\S]*?-----END [^-]*PRIVATE KEY-----/g, '[REDACTED KEY]')
    .replace(/\bBearer\s+[^\s"']+/gi, 'Bearer [REDACTED]').replace(/\b(?:sk-[A-Za-z0-9_-]{8,}|gh[pousr]_[A-Za-z0-9_]{8,})\b/g, '[REDACTED TOKEN]')
    .replace(/\b(?:AKIA)[A-Z0-9]{16}\b/g, '[REDACTED TOKEN]')
    .replace(/\bgithub_pat_[A-Za-z0-9_]{8,}\b/g, '[REDACTED TOKEN]')
    .replace(/\b(postgres(?:ql)?:\/\/)[^\s/:@]+:[^\s/@]+@/gi, '$1[REDACTED]@')
    .replace(/\b(api_key|apikey)\s*=\s*[^\s,;]+/gi, '$1=[REDACTED]')
    .replace(/\b([A-Z0-9_]*(?:KEY|TOKEN|SECRET|PASSWORD)[A-Z0-9_]*)\s*=\s*[^\s,;]+/gi, '$1=[REDACTED]');
}
function parseClaude(line) {
  let o; try { o = JSON.parse(line); } catch { return []; }
  const m = o.message || {}; const content = m.content;
  const ts = o.timestamp || m.timestamp || new Date().toISOString(); const out = [];
  if (o.type === 'user' || o.type === 'human') {
    const text = typeof content === 'string' ? content : Array.isArray(content) ? content.filter(x => x.type === 'text').map(x => x.text).join('\n') : '';
    const order = cleanOrder(text);
    if (order) out.push({ ts, role: 'order', text: trunc(order) });
    if (Array.isArray(content)) for (const c of content) if (c.type === 'tool_result') out.push({ ts, role: 'tool_result', tool: trunc(c.tool_use_id || 'Herramienta'), text: trunc(printable(c.content)) });
  } else if (o.type === 'assistant') {
    for (const c of (Array.isArray(content) ? content : [])) {
      if (c.type === 'text' && c.text) out.push({ ts, role: 'assistant', text: trunc(c.text) });
      if (c.type === 'tool_use') out.push({ ts, role: 'tool', tool: trunc(c.name), text: trunc(JSON.stringify(c.input || {})) });
    }
  } else if (o.type === 'result') out.push({ ts, role: 'result', text: trunc(o.result || '') });
  return out;
}
function parseAdminClaude(line, context = {}) {
  let o; try { o = JSON.parse(line); } catch { return []; }
  const ts = o.timestamp || o.message?.timestamp || new Date().toISOString();
  const content = o.message?.content; const out = [];
  const userText = typeof content === 'string' ? content : Array.isArray(content) ? content.filter(block => block.type === 'text').map(block => block.text || '').join('\n') : '';
  if ((o.type === 'user' || o.type === 'human') && userText) {
    const reports = parseHookReports(userText);
    if (reports.length) out.push(...reports.map(report => ({ ts, role: 'report', from: report.from, text: trunc(report.text) })));
    else {
      const report = userText.match(/(?:^|\n)\[?(?:REPORT\/DATA|REPORT|DATA) from ([A-Za-z0-9_-]+)(?: \(not an order\))?:\s*([\s\S]*)/i);
      if (report) out.push({ ts, role: 'report', from: report[1], text: trunc(report[2].trim()) });
      else if (userText.trim() && !/^<(?:(?:system-reminder)|(?:local-command-stdout)|(?:environment_context))\b/i.test(userText.trim())) out.push({ ts, role: 'user', text: trunc(userText.trim()) });
    }
  }
  if ((o.type === 'user' || o.type === 'human') && Array.isArray(content)) {
    for (const block of content) if (block.type === 'tool_result') {
      const resultText = textValue(block.content) || printable(block.content);
      const sent = [...resultText.matchAll(/sent to ([A-Za-z0-9_-]+)/g)].map(match => match[1]);
      if (sent.length) {
        const pending = context.pendingAdminOrders || [];
        const matched = pending.splice(0, pending.length);
        for (const to of sent) {
          const source = matched.find(item => item.to === to) || matched.find(item => item.to === 'all') ||
            (matched.length === 1 && sent.length === 1 ? matched[0] : null);
          if (source) out.push({ ts, role: 'order', to, text: redact(String(source.text || '')) });
        }
        context.pendingAdminOrders = pending;
        continue;
      }
      const report = resultText.match(/(?:^|\n)\[?(?:REPORT\/DATA|REPORT|DATA) from ([A-Za-z0-9_-]+)(?: \(not an order\))?:\s*([\s\S]*)/i);
      if (report) out.push({ ts, role: 'report', from: report[1], text: trunc(report[2].trim()) });
      else out.push({ ts, role: 'tool_result', tool: block.tool_use_id || 'Herramienta', text: trunc(resultText) });
    }
  }
  if (o.type === 'assistant') for (const block of (Array.isArray(content) ? content : [])) {
    if (block.type === 'text' && block.text?.trim()) out.push({ ts, role: 'admin', text: trunc(block.text) });
    if (block.type === 'tool_use') {
      const command = String(block.input?.command || '');
      let classified = false;
      if (block.name === 'Bash') {
        const parsed = parseAdminOrders(command);
        if (parsed.length) {
          const pings = parsed.filter(item => item.text === 'ping');
          out.push(...pings.map(item => ({ ts, role: 'order', to: item.to, text: item.text })));
          context.pendingAdminOrders = [...(context.pendingAdminOrders || []), ...parsed.filter(item => item.text !== 'ping')];
          classified = true;
        }
      }
      if (!classified) out.push({ ts, role: 'tool', tool: trunc(block.name || 'Herramienta'), text: trunc(printable(block.input || {})) });
    }
  }
  if (o.type === 'result') out.push({ ts, role: 'result', text: trunc(o.result || '') });
  return out;
}
function parseAdminOrders(command) {
  const text = String(command || '');
  const heredocs = new Map();
  for (const match of text.matchAll(/cat\s+>\s*([^\s]+)\s*<<\s*['"]?([\w.-]+)['"]?\s*\n([\s\S]*?)\n\2/g)) heredocs.set(match[1], match[3]);
  const commandPattern = /(?:^|[;\n&|]\s*)(?:~\/.claude-bridge\/bin\/agent|\$HOME\/\.claude-bridge\/bin\/agent|\$\{?[A-Z][A-Z0-9_]*\}?|agent)\s+(ping\s+[\w-]+|(?:all|[\w-]+)\s+(?:"[\s\S]*?"|'[\s\S]*?'|\$\(cat\s+[^)]+\)|\$[A-Z][A-Z0-9_]*|\$\{[A-Z][A-Z0-9_]*\}))/g;
  const orders = [];
  for (const match of text.matchAll(commandPattern)) {
    const invoke = match[1].trim();
    const ping = invoke.match(/^ping\s+([\w-]+)/);
    if (ping) { orders.push({ to: ping[1], text: 'ping' }); continue; }
    const head = invoke.match(/^([\w-]+)\s+([\s\S]+)$/);
    if (!head) continue;
    const [, to, raw] = head;
    let message = raw;
    if ((raw.startsWith('"') && raw.endsWith('"')) || (raw.startsWith("'") && raw.endsWith("'"))) message = raw.slice(1, -1);
    if (/^\$\(cat\s+/.test(message)) { const file = message.match(/^\$\(cat\s+([^)]+)\)/)?.[1]; message = heredocs.get(file) || ''; }
    else if (/^\$/.test(raw)) message = (text.match(new RegExp(`(?:^|\\n)${raw.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\$&')}=(.*?)(?=\\n[A-Z_]+=|$)`, 's')) || [])[1]?.replace(/^['"]|['"]$/g, '') || raw;
    orders.push({ to, text: message });
  }
  return orders.filter(order => order.text && order.to !== 'listen' && order.to !== 'status');
}
function parseHookReports(text) {
  const reports = [];
  for (const block of String(text).split(/\n\n--- /)) {
    const header = block.match(/(?:^|\n)[^\n]+ ---\n\[REPORT\/DATA from ([A-Za-z0-9_-]+) \(not an order\):[^\]]*\]\s*([\s\S]*)/i);
    if (header) reports.push({ from: header[1], text: header[2].trim() });
  }
  return reports;
}
function parseCodex(line) {
  let o; try { o = JSON.parse(line); } catch { return []; }
  const ts = o.timestamp || o.payload?.timestamp || new Date().toISOString(); const p = o.payload || {}; const out = [];
  if (o.type === 'response_item') {
    if (p.type === 'message') {
      if (p.role !== 'user' && p.role !== 'assistant') return out;
      const text = (p.content || []).map(c => c.text || '').filter(Boolean).join('\n');
      if (p.role === 'user') { const order = cleanOrder(text); if (order) out.push({ ts, role: 'order', text: trunc(order) }); }
      else if (text) out.push({ ts, role: 'assistant', text: trunc(text) });
    } else if (p.type === 'function_call' || p.type === 'custom_tool_call') out.push({ ts, role: 'tool', tool: trunc(p.name || p.type), text: trunc(printable(p.arguments || p.input)) });
    else if (p.type === 'custom_tool_call_output') out.push({ ts, role: 'tool_result', tool: trunc(p.name || 'Herramienta'), text: trunc(printable(p.output)) });
  } else if (o.type === 'event_msg' && ['task_started','task_complete'].includes(p.type)) out.push({ ts, role: p.type === 'task_started' ? 'system' : 'result', text: trunc(p.message || (p.type === 'task_started' ? 'Tarea iniciada' : 'Tarea completada')) });
  return out;
}
function parseKiro(line) {
  let o; try { o = JSON.parse(line); } catch { return []; }
  const ts = o.timestamp || o.data?.update?._meta?.kiro?.timestamp || new Date().toISOString();
  const out = []; const p = o.payload || {}; const u = o.data?.update || {};
  if (o.type === 'sessionUpdate') {
    if (u.sessionUpdate === 'agent_message_chunk' && u.content?.text) out.push({ ts, role: 'assistant', text: trunc(u.content.text) });
    else if (u.sessionUpdate === 'tool_call') out.push({ ts, role: 'tool', tool: trunc(u.toolCall?.title || u.toolCall?.name || 'Kiro tool'), text: trunc(printable(u.toolCall?.rawInput || u.toolCall?.input || '')) });
    else if (u.sessionUpdate === 'tool_call_update') out.push({ ts, role: 'tool_result', tool: trunc(u.toolCallId || 'Kiro tool'), text: trunc(printable(u.content || u.rawOutput || u.status || '')) });
  } else if (p.type === 'user') { const order = cleanOrder(p.content); if (order) out.push({ ts, role: 'order', text: trunc(order) }); }
  else if (p.type === 'assistant' && p.content) out.push({ ts, role: 'assistant', text: trunc(textValue(p.content) || printable(p.content)) });
  else if (p.type === 'tool_use' || p.type === 'tool_call') out.push({ ts, role: 'tool', tool: trunc(p.name || p.toolName || 'Kiro tool'), text: trunc(printable(p.input || p.arguments || {})) });
  else if (p.type === 'tool_result' || p.type === 'tool_call_update') out.push({ ts, role: 'tool_result', tool: trunc(p.name || p.toolName || 'Kiro tool'), text: trunc(printable(p.content || p.output || p.result || '')) });
  else if (o.type === 'runFinished' && o.data?.finalText) out.push({ ts, role: 'result', text: trunc(o.data.finalText) });
  return out;
}
function parseAgy(line, ts = new Date().toISOString()) {
  let o; try { o = JSON.parse(line); } catch { return []; }
  const out = []; const u = o.step_update || {};
  if (o.event === 'step_update' && u.step_type === 'tool') {
    const params = u.tool_info?.parameters || {};
    if (u.state === 'ACTIVE') out.push({ ts, role: 'tool', tool: trunc(u.tool_name || 'Antigravity tool'), text: trunc(printable(params.CommandLine || params.AbsolutePath || params.Query || params.TargetFile || params)) });
    else if (u.state === 'DONE') out.push({ ts, role: 'tool_result', tool: trunc(u.tool_name || 'Antigravity tool'), text: trunc(printable(u.tool_info?.output || '')) });
  } else if (o.event === 'result' && o.result?.response) out.push({ ts, role: 'result', text: trunc(o.result.response) });
  return out;
}
// Cursor (cursor-agent stream-json) reads from the runner's live log
function parseCursor(line, ts = new Date().toISOString()) {
  let o; try { o = JSON.parse(line); } catch { return []; }
  const out = [];
  if (o.type === 'tool_call' && o.tool_call && typeof o.tool_call === 'object') {
    const [key, val] = Object.entries(o.tool_call)[0] || ['tool', {}]; const a = val?.args || {}; const tool = trunc(String(key).replace(/ToolCall$/, ''));
    if (o.subtype === 'started') out.push({ ts, role: 'tool', tool, text: trunc(printable(a.command || a.path || a.pattern || a.query || a)) });
    else if (o.subtype === 'completed') out.push({ ts, role: 'tool_result', tool, text: trunc(printable(val?.result?.success?.stdout || val?.result?.success?.content || val?.result || '')) });
  } else if (o.type === 'assistant') { for (const c of o.message?.content || []) if (c.type === 'text' && c.text) out.push({ ts, role: 'assistant', text: trunc(c.text) }); }
  else if (o.type === 'result' && o.result) out.push({ ts, role: 'result', text: trunc(o.result) });
  return out;
}
// OpenCode (`opencode run --format json`) and GitHub Copilot (`copilot --output-format json`) read from the runner's live log
function parseOpenCode(line, ts = new Date().toISOString()) {
  let o; try { o = JSON.parse(line); } catch { return []; }
  const out = []; const p = o.part || {};
  if (o.type === 'text' && p.text) out.push({ ts, role: 'assistant', text: trunc(p.text) });
  else if (o.type === 'tool_use') {
    const st = p.state || {}; const a = st.input || {}; const tool = trunc(p.tool || 'OpenCode tool');
    out.push({ ts, role: 'tool', tool, text: trunc(printable(a.command || a.filePath || a.pattern || a)) });
    if (st.status === 'completed' && st.output) out.push({ ts, role: 'tool_result', tool, text: trunc(printable(st.output)) });
  } else if (o.type === 'error') out.push({ ts, role: 'result', text: trunc(printable(o.error?.data?.message || o.error?.message || o.error || 'error')) });
  return out;
}
function parseCopilot(line, ts = new Date().toISOString()) {
  let o; try { o = JSON.parse(line); } catch { return []; }
  const out = []; const d = o.data || {}; const t = String(o.type || '');
  if (t === 'assistant.message' && (d.content || o.content)) out.push({ ts, role: 'assistant', text: trunc(printable(d.content || o.content)) });
  else if (t.startsWith('tool.execution_start')) { const a = d.arguments || {}; out.push({ ts, role: 'tool', tool: trunc(d.toolName || 'Copilot tool'), text: trunc(printable(a.command || a.path || a.pattern || a)) }); }
  else if (t.startsWith('tool.execution_complete')) out.push({ ts, role: 'tool_result', tool: trunc(d.toolName || 'Copilot tool'), text: trunc(printable(d.result?.content || d.result || '')) });
  return out;
}
function tail(file, maxBytes = 1_000_000) {
  let fd;
  try {
    fd = fs.openSync(file, 'r'); const size = fs.fstatSync(fd).size; const start = Math.max(0, size - maxBytes); const len = size - start;
    const b = Buffer.alloc(len); fs.readSync(fd, b, 0, len, start); let text = b.toString('utf8');
    if (start > 0) text = text.slice(text.indexOf('\n') + 1);
    const complete = text.lastIndexOf('\n');
    if (complete < 0) return [];
    return text.slice(0, complete).split('\n').filter(Boolean);
  } catch { return []; } finally { if (fd !== undefined) try { fs.closeSync(fd); } catch {} }
}
function tailUseful(file, parser, limit = 200, maxBytes = 16 * 1024 * 1024) {
  let size = 128 * 1024; let events = [];
  do {
    const context = {};
    events = tail(file, size).flatMap(line => parser(line, context)).filter(e => e.role !== 'system');
    if (events.length >= limit || size >= maxBytes) break;
    size = Math.min(size * 2, maxBytes);
  } while (true);
  return events.slice(-limit);
}
function selectEvents(events, opts = {}) {
  const since = opts.since ? Date.parse(opts.since) : 0;
  const limit = Number.isSafeInteger(Number(opts.limit)) && Number(opts.limit) > 0 ? Number(opts.limit) : 60;
  return events.filter(e => e.role !== 'system' && Date.parse(e.ts) >= since).sort((a, b) => Date.parse(a.ts) - Date.parse(b.ts)).slice(-limit);
}
function feed(name, opts = {}) {
  const root = process.env.BRIDGE_DIR || path.join(os.homedir(), '.claude-bridge');
  const names = fs.readFileSync(path.join(root,'names.conf'),'utf8').split(/\r?\n/).map(x=>x.split('=')[1]).filter(Boolean);
  if (!names.includes(name)) throw new Error('Agente desconocido');
  let adminName = ''; try { adminName = fs.readFileSync(path.join(root, 'admin'), 'utf8').trim(); } catch {}
  const isAdmin = adminName === name;
  const limit = opts.limit || (isAdmin ? 200 : 60);
  const events=[]; const statePath=path.join(root,'runs',`${name}.state`); let state={};
  try { for(const l of fs.readFileSync(statePath,'utf8').split(/\r?\n/)){const i=l.indexOf('=');if(i>0)state[l.slice(0,i)]=l.slice(i+1);} } catch {}
  const map=path.join(root,'names.conf'); const config=fs.readFileSync(map,'utf8').split(/\r?\n/).find(x=>x.split('=')[1]===name)?.split('=')[0];
  const readFiles=(dir, parser, identifiers=[]) => { if(!dir||!fs.existsSync(dir))return; const files=[]; const walk=d=>{try{for(const e of fs.readdirSync(d,{withFileTypes:true})){const f=path.join(d,e.name);if(e.isDirectory())walk(f);else if(e.name.endsWith('.jsonl'))files.push(f);}}catch{}};walk(dir); files.sort((a,b)=>fs.statSync(b).mtimeMs-fs.statSync(a).mtimeMs); const selected=identifiers.length?files.filter(f=>identifiers.some(id=>path.basename(f).includes(id))).slice(0,3):files.slice(0,3); for(const f of selected)for(const l of tail(f))events.push(...parser(l)); };
  const sessions=path.join(root,'sessions',name); const ids=[];try{for(const f of fs.readdirSync(sessions).sort((a,b)=>fs.statSync(path.join(sessions,b)).mtimeMs-fs.statSync(path.join(sessions,a)).mtimeMs)){const id=fs.readFileSync(path.join(sessions,f),'utf8').trim();if(id)ids.push(id);}}catch{}
  const kind=(()=>{try{return require('child_process').execFileSync(path.join(__dirname,'bridge-provider'),[config||''],{encoding:'utf8'}).trim();}catch{return path.basename(config||'').startsWith('.codex')?'codex':'claude';}})();
  if (isAdmin && kind === 'claude') {
    let usage = {};
    try { usage = JSON.parse(fs.readFileSync(path.join(root, 'usage', `${name}.json`), 'utf8')); } catch {}
    if (typeof usage.transcript_path === 'string' && usage.session_id && fs.existsSync(usage.transcript_path)) {
      events.push(...tailUseful(usage.transcript_path, parseAdminClaude, limit));
    }
  } else if(kind==='claude') { const files=[]; const projects=path.join(config||'', 'projects'); const walk=d=>{try{for(const e of fs.readdirSync(d,{withFileTypes:true})){const f=path.join(d,e.name);if(e.isDirectory())walk(f);else if(e.name.endsWith('.jsonl'))files.push(f);}}catch{}};walk(projects); const chosen=ids.length?ids.map(id=>files.find(x=>path.basename(x).includes(id))).filter(Boolean):files.sort((a,b)=>fs.statSync(b).mtimeMs-fs.statSync(a).mtimeMs).slice(0,1); for(const f of chosen)for(const l of tail(f))events.push(...parseClaude(l)); }
  else if(kind==='kiro') {
    const saved=path.join(root,'sessions',name); let sessionId=''; try { for(const f of fs.readdirSync(saved).map(x=>path.join(saved,x)).filter(f=>!f.endsWith('.cwd'))){sessionId=fs.readFileSync(f,'utf8').trim();if(sessionId)break;} } catch {}
    const files=[]; const walk=d=>{try{for(const e of fs.readdirSync(d,{withFileTypes:true})){const f=path.join(d,e.name);if(e.isDirectory())walk(f);else if(e.name==='messages.jsonl')files.push(f);}}catch{}}; walk(path.join(config||'', 'sessions'));
    const chosen=sessionId?files.filter(f=>f.includes(`${sessionId}/`)):files.sort((a,b)=>fs.statSync(b).mtimeMs-fs.statSync(a).mtimeMs).slice(0,1);
    for(const f of chosen)for(const l of tail(f))events.push(...parseKiro(l));
  }
  else if(kind==='antigravity') { // the runner's live log (stream-json of the last order); agy keeps no readable transcript
    const live=path.join(root,'logs',`${name}.live`); let ts=new Date().toISOString(); try{ts=fs.statSync(live).mtime.toISOString();}catch{}
    for(const l of tail(live))events.push(...parseAgy(l,ts));
  }
  else if(kind==='opencode'||kind==='copilot') { // the runner's live log (JSON events of the last order)
    const live=path.join(root,'logs',`${name}.live`); let ts=new Date().toISOString(); try{ts=fs.statSync(live).mtime.toISOString();}catch{}
    for(const l of tail(live))events.push(...(kind==='opencode'?parseOpenCode:parseCopilot)(l,ts));
  }
  else if(kind==='cursor') { // the runner's live log (stream-json of the last order)
    const live=path.join(root,'logs',`${name}.live`); let ts=new Date().toISOString(); try{ts=fs.statSync(live).mtime.toISOString();}catch{}
    for(const l of tail(live))events.push(...parseCursor(l,ts));
  }
  else { const homes=[...new Set([path.join(os.homedir(),'.codex'), ...fs.readdirSync(os.homedir()).filter(x=>x.startsWith('.codex')).map(x=>path.join(os.homedir(),x)),config||''])]; for(const h of homes)readFiles(path.join(h,'sessions'),parseCodex,ids); }
  try { const log=tail(path.join(root,'logs',`${name}.log`),200000).slice(-80); for(const l of log){const m=l.match(/^\[([^\]]+)\] (.*)$/);if(m)events.push({ts:m[1],role:/order from/.test(m[2])?'order':'system',text:trunc(m[2])});} } catch {}
  if (!isAdmin) {
    try {
      const noteLines = fs.readFileSync(path.join(root, 'notes', `${name}.md`), 'utf8').split(/\r?\n/).slice(-limit * 2);
      for (const line of noteLines) {
        const note = line.match(/^- (\d{4}-\d\d-\d\d \d\d:\d\d:\d\d) from ([A-Za-z0-9_-]+) \[[^\]]*\] rc=\d+: (.*)$/);
        if (!note || note[2] !== adminName) continue;
        const noteTs = new Date(note[1].replace(' ', 'T')).toISOString();
        const noteText = trunc(note[3]);
        const duplicate = events.some(event => event.role === 'order' && Math.abs(Date.parse(event.ts) - Date.parse(noteTs)) < 120_000 &&
          (noteText.includes(event.text) || event.text.includes(noteText)));
        if (!duplicate) events.push({ ts: noteTs, role: 'order', to: name, text: noteText });
      }
    } catch {}
  }
  if(state.order) events.push({ts:new Date(Number(state.since||Date.now()/1000)*1000).toISOString(),role:'order',text:trunc(state.order)});
  return {name,state:{status:state.status||'unknown',since:Number(state.since)||null,activity:trunc(state.activity)},events:selectEvents(events,{...opts,limit})};
}
if(require.main===module){const [name,...args]=process.argv.slice(2);const li=args.indexOf('--limit');const limit=li>=0?Number(args[li+1]):undefined;const si=args.indexOf('--since');try{const result=feed(name,{limit,since:si>=0?args[si+1]:undefined});console.log(args.includes('--json')?JSON.stringify(result):result.events.map(e=>`${e.ts} ${e.role}: ${e.text}`).join('\n'));}catch(e){console.error(e.message);process.exit(1);}}
module.exports={feed,parseClaude,parseAdminClaude,parseCodex,parseKiro,parseAgy,parseCursor,parseOpenCode,parseCopilot,redact,tail,tailUseful,selectEvents,cleanOrder,printable};
