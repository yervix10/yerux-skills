#!/usr/bin/env bash
# bridge-runner <name>: terminal-less worker. Waits for the admin's orders in its inbox, runs them with
# `claude -p` / `codex exec` (with memory: resumes the conversation per working directory) and replies to the admin.
B="${BRIDGE_DIR:-$HOME/.claude-bridge}"; name="${1:?usage: bridge-runner <name>}"
dir="$(awk -F= -v n="$name" '$2==n{print $1; exit}' "$B/names.conf" 2>/dev/null)"
[ -n "$dir" ] || { echo "unknown name: $name" >&2; exit 1; }
kind="$("$(dirname "$0")/bridge-provider" "$dir")" || { echo "unknown type: $dir" >&2; exit 1; }
mkdir -p "$B/inbox/$name" "$B/read/$name" "$B/logs" "$B/sessions/$name" "$B/notes" "$B/runs"
LOG="$B/logs/$name.log"; NOTES="$B/notes/$name.md"
# portability: timeout/gtimeout may be missing (macOS); uuid via python3 or uuidgen
if command -v timeout >/dev/null 2>&1; then TO=timeout; elif command -v gtimeout >/dev/null 2>&1; then TO=gtimeout; else TO=""; fi
run_to() { local t="$1"; shift; if [ -n "$TO" ] && [ "$t" != 0 ]; then "$TO" "$t" "$@"; else "$@"; fi; }
newuuid() { python3 -c 'import uuid;print(uuid.uuid4())' 2>/dev/null || uuidgen | tr 'A-Z' 'a-z'; }
log() { echo "$(date '+%F %T') $*" >> "$LOG"; }
trap 'log "runner stopped"; [ -n "$CHILD" ] && kill "$CHILD" 2>/dev/null; S_STATUS=stopped; sw; exit 0' TERM INT
log "runner $name ($kind, $dir) started"
# No time limit per order by default; BRIDGE_TASK_TIMEOUT=<seconds> sets one.
TMO="${BRIDGE_TASK_TIMEOUT:-0}"
# Bypass mode (no permission prompts) by default so the admin's orders do not fail. BRIDGE_BYPASS=0 disables it.
BYPASS="${BRIDGE_BYPASS:-$(sed -n 's/^BYPASS=//p' "$B/config" 2>/dev/null | head -1)}"; BYPASS="${BYPASS:-1}"
CLAUDE_PERM=(); CODEX_PERM_NEW=(-s workspace-write); CODEX_PERM_RES=(-c sandbox_mode=\"workspace-write\")
# BRIDGE_BYPASS=safe: Claude may edit files but not run arbitrary commands without approval; Codex stays in its workspace-write sandbox.
if [ "$BYPASS" = safe ]; then CLAUDE_PERM=(--permission-mode acceptEdits); fi
if [ "$BYPASS" = 1 ]; then CLAUDE_PERM=(--dangerously-skip-permissions); CODEX_PERM_NEW=(--dangerously-bypass-approvals-and-sandbox); CODEX_PERM_RES=(--dangerously-bypass-approvals-and-sandbox); fi
log "bypass=$BYPASS"
# ---- observability: state file (read by `agent status`), heartbeat, and alerts to the admin ----
ST="$B/runs/$name.state"; ALERT="${BRIDGE_ALERT:-$(sed -n 's/^ALERT=//p' "$B/config" 2>/dev/null | head -1)}"; ALERT="${ALERT:-1800}"
S_STATUS=idle; S_SINCE=$(date +%s); S_ORDER=""; S_END=""; S_RC=""; S_KIND=""; LASTBEAT=0; CHILD=""
COMPACT_AT="${BRIDGE_COMPACT_AT:-$(sed -n 's/^COMPACT_AT=//p' "$B/config" 2>/dev/null | head -1)}"; COMPACT_AT="${COMPACT_AT:-40}"   # % of context that triggers a compaction before the next order (0 = off)
[[ "$COMPACT_AT" =~ ^[0-9]+$ ]] && [ "$COMPACT_AT" -le 100 ] || COMPACT_AT=40
CLAUDE_COMPACT_ENABLED=true; [ "$COMPACT_AT" -gt 0 ] || CLAUDE_COMPACT_ENABLED=false
CLAUDE_COMPACT_ARGS=(--settings "{\"autoCompactEnabled\":$CLAUDE_COMPACT_ENABLED}")
[ "$COMPACT_AT" -gt 0 ] && CLAUDE_COMPACT_ARGS+=(--autocompact auto)
LIVE="$B/logs/$name.live"; S_ACT=""; S_ACT_AT=""; PAUSE_UNTIL=0; STALL="${BRIDGE_STALL:-600}"; STALLED_AT=""; LIMIT_PAUSE="${BRIDGE_LIMIT_PAUSE:-300}"
sw() { printf 'status=%s\nsince=%s\nbeat=%s\norder=%s\nlast_end=%s\nlast_rc=%s\nlast_kind=%s\nactivity=%s\nactivity_at=%s\npause_until=%s\n' "$S_STATUS" "$S_SINCE" "$(date +%s)" "$S_ORDER" "$S_END" "$S_RC" "$S_KIND" "$S_ACT" "$S_ACT_AT" "$PAUSE_UNTIL" > "$ST.tmp" 2>/dev/null && mv "$ST.tmp" "$ST"; }
# act: last thing a Claude worker did (tool call) and when, read from its live stream-json log
act() { [ -s "$LIVE" ] || return 0
  if [ "$kind" = codex ]; then
    S_ACT="$(tail -n 40 "$LIVE" | jq -r 'select(.type=="item.started" or .type=="item.completed")|.item|select(.type!="agent_message" and .type!="reasoning")|"\(.type) \((.command // .path // .query // "")|tostring|.[0:70])"' 2>/dev/null | tail -1 | tr '\n' ' ')"
  elif [ "$kind" = kiro ]; then
    S_ACT="$(tail -n 60 "$LIVE" | jq -r 'select(.type=="sessionUpdate")|.data.update as $u|select($u.sessionUpdate=="tool_call")|"\($u.title // $u.toolCall.name // "herramienta") \(($u.toolCall.rawInput // "")|tostring|.[0:70])"' 2>/dev/null | tail -1 | tr '\n' ' ')"
  else
  S_ACT="$(tail -n 40 "$LIVE" | jq -r 'select(.type=="assistant")|.message.content[]?|select(.type=="tool_use")|"\(.name) \((.input.command // .input.file_path // .input.pattern // .input.description // "")|tostring|.[0:70])"' 2>/dev/null | tail -1 | tr '\n' ' ')"
  fi
  S_ACT_AT="$(stat -c %Y "$LIVE" 2>/dev/null || stat -f %m "$LIVE" 2>/dev/null)"; return 0; }
beat() { local n; n=$(date +%s); [ $((n - LASTBEAT)) -ge 5 ] && { LASTBEAT=$n; [ "$S_STATUS" = working ] && act; sw; }; return 0; }
notify_desktop() { [ "${BRIDGE_NOTIFY:-1}" = 0 ] && return 0
  if command -v notify-send >/dev/null 2>&1; then notify-send "agent-bridge: $name" "$1" >/dev/null 2>&1
  elif command -v osascript >/dev/null 2>&1; then osascript -e "display notification \"$(printf '%s' "$1" | tr -d '"\\')\" with title \"agent-bridge: $name\"" >/dev/null 2>&1; fi; return 0; }
notify_admin() { notify_desktop "${1:0:140}"; local a; a="$(cat "$B/admin" 2>/dev/null)"; [ -n "$a" ] && BRIDGE_NAME="$name" "$(dirname "$0")/bridge-send" "$a" "$1" >/dev/null 2>&1; return 0; }
# supervise <pid>: waits for the order's process, keeps the heartbeat and warns the admin every $ALERT seconds (it never kills it)
supervise() { local pid="$1" t0 n=0 el; t0=$(date +%s); CHILD=$pid
  while kill -0 "$pid" 2>/dev/null; do sleep 2; beat; el=$(( $(date +%s) - t0 ))
    if [ "$STALL" -gt 0 ] && [ -n "$S_ACT_AT" ] && [ $(( $(date +%s) - S_ACT_AT )) -ge "$STALL" ] && [ "$STALLED_AT" != "$S_ACT_AT" ]; then STALLED_AT="$S_ACT_AT"
      log "no activity for $(( ($(date +%s) - S_ACT_AT) / 60 )) min"
      notify_admin "STALLED: worker '$name' has produced no activity for $(( ($(date +%s) - S_ACT_AT) / 60 )) min (last: ${S_ACT:-none}). It may be hung or waiting on the provider. Check: agent status | agent logs $name"; fi
    if [ "$ALERT" -gt 0 ] && [ $el -ge $(( (n + 1) * ALERT )) ]; then n=$((n + 1))
      log "still working after $((el / 60)) min: $S_ORDER"
      notify_admin "ALERT: worker '$name' has been on the same order for $(if [ $el -ge 120 ]; then echo "$((el / 60)) min"; else echo "${el}s"; fi) and has not replied yet (still running, not killed). Order: $S_ORDER. Check: agent status | agent logs $name | agent reset $name"; fi; done
  wait "$pid"; local rc=$?; CHILD=""; return $rc; }
# ctx_now: context used (%) by this worker, as of the end of its previous order (empty when unknown)
ctx_now() { local used win
  if [ "$kind" = claude ]; then [ -s "$LIVE" ] || return 0
    used="$(jq -r 'select(.type=="assistant")|.message.usage|((.input_tokens // 0)+(.cache_read_input_tokens // 0)+(.cache_creation_input_tokens // 0))' "$LIVE" 2>/dev/null | tail -1)"
    win="$(jq -r 'select(.type=="result")|.modelUsage|to_entries[0].value.contextWindow // empty' "$LIVE" 2>/dev/null | tail -1)"
    [ -n "$used" ] && [ -n "$win" ] && [ "$win" -gt 0 ] 2>/dev/null && echo $((used * 100 / win))
  elif [ "$kind" = kiro ]; then
    local sess f; sess="$(cat "$sf" 2>/dev/null)"; [ -n "$sess" ] || return 0
    f="$(find "$dir/sessions" -path "*/$sess/messages.jsonl" -type f 2>/dev/null | head -1)"; [ -n "$f" ] || return 0
    jq -r 'select(.payload.type=="session_metadata" and .payload.key=="contextUsage")|.payload.value.usagePercentage // empty' "$f" 2>/dev/null | tail -1 | awk '{printf "%d\n", $1+0.5}'
  else # Codex: read the context of THIS runner's own session (its thread id is in $sf), not the newest session of the account
    local sess f; sess="$(cat "$sf" 2>/dev/null)"; [ -n "$sess" ] || return 0
    f="$(find "$dir/sessions" -name "*$sess*.jsonl" -type f 2>/dev/null | head -1)"; [ -n "$f" ] || return 0
    tail -n 400 "$f" | jq -r 'select(.type=="event_msg" and .payload.type=="token_count" and .payload.info!=null and .payload.info.model_context_window!=null)|((.payload.info.last_token_usage.total_tokens*100/.payload.info.model_context_window)|floor)' 2>/dev/null | tail -1 | grep -E '^[0-9]+$'; fi; return 0; }
# Resolve the selected Codex model's window and set its native compaction threshold for this order.
codex_compact_token_limit() {
  local sess f win model catalog
  [ "$COMPACT_AT" -gt 0 ] 2>/dev/null || return 0
  sess="$(cat "$sf" 2>/dev/null)"; f=""
  [ -n "$sess" ] && f="$(find "$dir/sessions" -name "*$sess*.jsonl" -type f 2>/dev/null | head -1)"
  if [ -n "$f" ]; then
    win="$(jq -r 'select(.type=="event_msg" and .payload.type=="token_count")|.payload.info.model_context_window // empty' "$f" 2>/dev/null | tail -1)"
    model="$(grep '"type":"turn_context"' "$f" 2>/dev/null | tail -1 | jq -r '.payload.model // empty' 2>/dev/null)"
    [[ "$win" =~ ^[0-9]+$ ]] && { echo $((win * COMPACT_AT / 100)); return; }
  fi
  model="$(cat "$B/models/$name" 2>/dev/null)"
  [ -n "$model" ] || model="$(awk -F= '/^[[:space:]]*model[[:space:]]*=/{gsub(/[\"[:space:]]/,\"\",$2); print $2; exit}' "$dir/config.toml" 2>/dev/null)"
  catalog="$(CODEX_HOME="$dir" codex debug models --bundled 2>/dev/null)"
  if [ -n "$model" ]; then win="$(printf '%s' "$catalog" | jq -r --arg m "$model" '.models[]|select(.slug==$m)|.context_window // empty' 2>/dev/null | head -1)"
  else win="$(printf '%s' "$catalog" | jq -r '(.models|map(select(.visibility=="list"))|sort_by(.priority)|.[0].context_window) // empty' 2>/dev/null)"; fi
  [[ "$win" =~ ^[0-9]+$ ]] && [ "$win" -gt 0 ] && echo $((win * COMPACT_AT / 100))
}
add_codex_compact_arg() { local limit; [ "$kind" = codex ] || return 0
  limit="$(codex_compact_token_limit)"; [[ "$limit" =~ ^[0-9]+$ ]] && [ "$limit" -gt 0 ] && MODEL_ARGS+=(-c "model_auto_compact_token_limit=$limit")
  [ -z "$limit" ] || log "native Codex auto-compact threshold=${limit} tokens (${COMPACT_AT}% context)"; }
# maybe_compact: before an order, if the context is >= $COMPACT_AT %, shrink it. Claude: `/compact` on the resumed session.
# Codex has no compact in `exec`, so it writes a handoff summary, the session is dropped and the next one starts from that summary.
maybe_compact() { local force="${1:-0}" c rc=0 out hf; [ -f "$sf" ] || return 0
  if [ "$force" != 1 ]; then [ "$COMPACT_AT" -gt 0 ] 2>/dev/null || return 0; fi
  c="$(ctx_now)"; [ -n "$c" ] || c=0
  if [ "$force" != 1 ]; then [ "$c" -ge "$COMPACT_AT" ] || return 0; fi
  log "context at ${c}% (>= ${COMPACT_AT}%): compacting"; S_STATUS=working; S_SINCE=$(date +%s); S_ORDER="compacting context (${c}%)"; sw
  if [ "$kind" = claude ]; then
    ( cd "$cwd" && export CLAUDE_CONFIG_DIR="$dir" BRIDGE_NO_HOOK=1 BRIDGE_NAME="$name"; if [ "$COMPACT_AT" -gt 0 ]; then export CLAUDE_AUTOCOMPACT_PCT_OVERRIDE="$COMPACT_AT"; else unset CLAUDE_AUTOCOMPACT_PCT_OVERRIDE; fi; run_to 900 claude -p --output-format stream-json --verbose "${MODEL_ARGS[@]}" "${CLAUDE_COMPACT_ARGS[@]}" "${CLAUDE_PERM[@]}" --resume "$(cat "$sf")" "/compact" ) > "$B/logs/$name.compact" 2>&1 < /dev/null & supervise $! || rc=$?
    if grep -q compact_boundary "$B/logs/$name.compact" 2>/dev/null; then log "compacted (was ${c}%)"; else log "compaction failed (rc=$rc), continuing without it"; fi
  elif [ "$kind" = kiro ]; then
    out="$(mktemp)"; hf="$B/notes/$name.handoff.md"
    ( cd "$cwd" && BRIDGE_NO_HOOK=1 BRIDGE_NAME="$name" run_to 900 kiro-cli chat --no-interactive --trust-all-tools --trust-workspace --output-format stream-json "${MODEL_ARGS[@]}" --resume-id "$(cat "$sf")" "Your context is nearly full. Write a concise handoff (max 40 lines): project/worktree, branch, completed work, in-progress work, decisions, gotchas and exact next steps. Return only the handoff; do not run tools." ) > "$B/logs/$name.compact" 2>&1 & supervise $! || rc=$?
    jq -r 'select(.type=="runFinished")|.data.finalText // empty' "$B/logs/$name.compact" 2>/dev/null | tail -1 > "$out"
    if [ "$rc" = 0 ] && [ -s "$out" ]; then cp "$out" "$hf"; rm -f "$sf"; prompt="$prompt

[Handoff summary from the previous Kiro session:]
$(cat "$hf")"; log "compacted by handoff (was ${c}%)"; else log "handoff failed (rc=$rc), continuing without compaction"; fi
    rm -f "$out"
  else
    out="$(mktemp)"; hf="$B/notes/$name.handoff.md"
    ( cd "$cwd" && BRIDGE_NO_HOOK=1 BRIDGE_NAME="$name" CODEX_HOME="$dir" run_to 900 codex exec resume --json "${MODEL_ARGS[@]}" "${CODEX_PERM_RES[@]}" --skip-git-repo-check -o "$out" "$(cat "$sf")" "Your context is nearly full and this conversation is about to be replaced by a fresh one. Reply ONLY with a concise handoff (max 40 lines): your project and worktree, branch, what is done (commits), what is in progress, decisions and gotchas, exact next steps. Do not run any tools." < /dev/null ) > "$B/logs/$name.compact" 2>&1 & supervise $! || rc=$?
    if [ "$rc" = 0 ] && [ -s "$out" ]; then cp "$out" "$hf"; rm -f "$sf"; prompt="$prompt

[Your previous conversation was compacted because its context reached ${c}%. Handoff summary you wrote:]
$(cat "$hf")"; log "compacted by handoff (was ${c}%)"; else log "handoff failed (rc=$rc), continuing without compaction"; fi
    rm -f "$out"; fi
  return 0; }
# Force compaction using the most recently used saved session. Requests are consumed while idle;
# a request submitted during a task is handled at the next loop turn, before another order starts.
manual_compact() {
  local session_dir="$B/sessions/$name" mdl eff
  sf="$(ls -t "$session_dir"/* 2>/dev/null | while IFS= read -r f; do case "$f" in *.cwd) continue;; esac; [ -f "$f" ] && { printf '%s\n' "$f"; break; }; done)"
  [ -n "$sf" ] || { log "manual compaction unavailable: no saved session"; return 1; }
  cwd="$(cat "$sf.cwd" 2>/dev/null)"
  if [ -z "$cwd" ]; then
    local session_id transcript
    session_id="$(cat "$sf" 2>/dev/null)"
    if [ "$kind" = claude ]; then
      transcript="$(find "$dir/projects" -name "*$session_id*.jsonl" -type f 2>/dev/null | head -1)"
      [ -n "$transcript" ] && cwd="$(jq -r 'select(.cwd!=null)|.cwd' "$transcript" 2>/dev/null | head -1)"
    else
      transcript="$(find "$dir/sessions" -name "*$session_id*.jsonl" -type f 2>/dev/null | head -1)"
      [ -n "$transcript" ] && cwd="$(head -1 "$transcript" | jq -r 'select(.type=="session_meta")|.payload.cwd // empty' 2>/dev/null)"
    fi
    [ -n "$cwd" ] && printf '%s' "$cwd" > "$sf.cwd"
  fi
  [ -d "$cwd" ] || { log "manual compaction unavailable: saved project directory is missing or unknown"; return 1; }
  MODEL_ARGS=(); mdl="$(cat "$B/models/$name" 2>/dev/null)"; eff="$(cat "$B/effort/$name" 2>/dev/null)"
  if [ -n "$mdl" ]; then case "$kind" in claude) MODEL_ARGS=(--model "$mdl");; codex) MODEL_ARGS=(-m "$mdl");; kiro) MODEL_ARGS=(--model "$mdl");; esac; fi
  if [ -n "$eff" ]; then case "$kind" in claude|kiro) MODEL_ARGS+=(--effort "$eff");; codex) MODEL_ARGS+=(-c "model_reasoning_effort=\"$eff\"");; esac; fi
  add_codex_compact_arg
  log "manual compaction requested"; maybe_compact 1
  return 0
}
# pick_worker: an idle runner (other than this one and the admin) that can take over an order; empty when none
pick_worker() { local t; for t in $(awk -F= '{print $2}' "$B/names.conf" 2>/dev/null); do
    [ "$t" = "$name" ] && continue; [ "$t" = "$(cat "$B/admin" 2>/dev/null)" ] && continue
    [ -f "$B/runs/$t.pid" ] && kill -0 "$(cat "$B/runs/$t.pid")" 2>/dev/null || continue
    [ "$(sed -n 's/^status=//p' "$B/runs/$t.state" 2>/dev/null | head -1)" = idle ] && { echo "$t"; return; }; done; }
reassign() { local t="$1" f; mkdir -p "$B/inbox/$t"; f="$B/inbox/$t/$(date +%Y%m%dT%H%M%S).$$-de-$from.msg"
  printf 'From: %s\nTo: %s\nDate: %s\nCwd: %s\n\n[reassigned from %s: it hit a usage limit]\n%s\n' "$from" "$t" "$(date '+%F %T')" "$orig_cwd" "$name" "$body" > "$f.tmp" && mv "$f.tmp" "$f"; }
REASSIGN="${BRIDGE_REASSIGN:-$(sed -n 's/^REASSIGN=//p' "$B/config" 2>/dev/null | head -1)}"; REASSIGN="${REASSIGN:-0}"
# classify <rc> <text> -> ok | limit | api | timeout | error
classify() { local rc="$1" low; low="$(printf '%s' "$2" | tr 'A-Z' 'a-z')"
  [ "$rc" = 124 ] && { echo timeout; return; }
  if [ "$rc" != 0 ]; then
    case "$low" in *"usage limit"*|*"rate limit"*|*"rate_limit"*|*"limit reached"*|*"hit your limit"*|*quota*|*"too many requests"*|*"credit balance"*|*"limit will reset"*|*"resets at"*|*"resets in"*) echo limit; return;;
      *overloaded*|*"api error"*|*"authentication"*|*"invalid api key"*|*"invalid x-api-key"*|*econnrefused*|*econnreset*|*"network error"*|*"503"*|*"529"*|*"502"*|*"401"*|*unauthorized*) echo api; return;; esac
    echo error; return; fi
  if [ ${#2} -lt 300 ]; then case "$low" in *"usage limit"*|*"rate limit"*|*"limit reached"*|*"hit your limit"*) echo limit; return;; esac; fi
  echo ok; }
sw
# Worktrees: when the order's cwd is a git project, the worker runs in its own worktree <project>/.worktrees/<name>
# (branch mejora/<name>) so several workers never edit the same checkout. BRIDGE_WORKTREE=0 disables it.
WT="${BRIDGE_WORKTREE:-$(sed -n 's/^WORKTREE=//p' "$B/config" 2>/dev/null | head -1)}"; WT="${WT:-1}"
log "worktree=$WT"
worktree_for() { # <cwd> -> prints the cwd to use (the worktree path, or the original one)
  local c="$1" root gd common rel wt
  [ "$WT" = 1 ] && command -v git >/dev/null 2>&1 || { printf '%s' "$c"; return; }
  root="$(git -C "$c" rev-parse --show-toplevel 2>/dev/null)" || { printf '%s' "$c"; return; }
  gd="$(git -C "$c" rev-parse --absolute-git-dir 2>/dev/null)"; common="$(cd "$c" && cd "$(git rev-parse --git-common-dir)" 2>/dev/null && pwd)"
  case "$gd" in "$common"/worktrees/*) printf '%s' "$c"; return;; esac   # already inside a linked worktree
  rel="${c#$root}"; wt="$root/.worktrees/$name"
  if [ ! -d "$wt" ]; then
    mkdir -p "$root/.worktrees"
    grep -qx '.worktrees/' "$common/info/exclude" 2>/dev/null || { mkdir -p "$common/info"; echo '.worktrees/' >> "$common/info/exclude"; }
    if git -C "$root" show-ref --verify --quiet "refs/heads/mejora/$name"; then git -C "$root" worktree add "$wt" "mejora/$name" >/dev/null 2>&1
    else git -C "$root" worktree add "$wt" -b "mejora/$name" >/dev/null 2>&1; fi \
      || { log "worktree failed in $root, using $c"; printf '%s' "$c"; return; }
    log "worktree created: $wt"
  fi
  [ -d "$wt$rel" ] && printf '%s' "$wt$rel" || printf '%s' "$wt"; }
while true; do
  if [ -f "$B/runs/$name.compact.request" ] && [ "$S_STATUS" = idle ]; then
    rm -f "$B/runs/$name.compact.request"
    S_STATUS=working; S_SINCE=$(date +%s); S_ORDER="manual compaction"; sw
    manual_compact || true
    S_STATUS=idle; S_ORDER=""; S_SINCE=$(date +%s); S_END=$S_SINCE; sw
  fi
  f="$(ls "$B/inbox/$name"/*.msg 2>/dev/null | sort | head -1)"
  if [ "$(date +%s)" -lt "$PAUSE_UNTIL" ]; then [ "$S_STATUS" = limited ] || { S_STATUS=limited; sw; }; beat; sleep 2; continue; fi
  [ "$S_STATUS" = limited ] && { S_STATUS=idle; sw; }
  [ -n "$f" ] || { beat; sleep 1; continue; }
  sleep 0.3
  base="$(basename "$f" .msg)"; from="${base##*-de-}"
  cwd="$(sed -n 's/^Cwd: //p' "$f" | head -1)"; [ -d "$cwd" ] || cwd="$HOME"; orig_cwd="$cwd"; cwd="$(worktree_for "$cwd")"
  body="$(awk 'f{print} /^$/ && !f{f=1}' "$f")"
  mv "$f" "$B/read/$name/"
  if [ "$from" != "$(cat "$B/admin" 2>/dev/null)" ]; then log "ignored (not from the admin): from $from"; continue; fi
  key="$(printf '%s' "$cwd" | cksum | cut -d' ' -f1)"; sf="$B/sessions/$name/$key"; printf '%s' "$cwd" > "$sf.cwd"
  case "$body" in "--new"*) rm -f "$sf"; body="$(printf '%s' "$body" | sed '1s/^--new[[:space:]]*//')";; esac
  prompt="You are worker '$name' in a team of coordinated sessions. The admin '$from' gives you this order. Carry it out with your tools and reply ONLY with the final result, briefly: your reply is sent to '$from' automatically.

Order:
$body"
  if [ "$kind" = kiro ]; then prompt="$prompt

Do not use the 'agent' or 'admin' command to send or report your answer. Do not send messages to the admin yourself. The runner forwards exactly one final response automatically; finish by returning your complete final answer as text."; fi
  log "order from $from in $cwd: $(printf '%s' "$body" | head -c 120 | tr '\n' ' ')"
  MODEL_ARGS=(); mdl="$(cat "$B/models/$name" 2>/dev/null)"   # set by the admin with `agent model`
  if [ -n "$mdl" ]; then case "$kind" in claude|kiro) MODEL_ARGS=(--model "$mdl");; codex) MODEL_ARGS=(-m "$mdl");; esac; fi
  eff="$(cat "$B/effort/$name" 2>/dev/null)"   # reasoning effort, also set by the admin (`agent effort`)
  if [ -n "$eff" ]; then case "$kind" in claude|kiro) MODEL_ARGS+=(--effort "$eff");; codex) MODEL_ARGS+=(-c "model_reasoning_effort=\"$eff\"");; esac; fi
  add_codex_compact_arg
  maybe_compact
  S_STATUS=working; S_SINCE=$(date +%s); S_ORDER="$(printf '%s' "$body" | head -c 100 | tr '\n' ' ')"; sw
  tmp="$(mktemp)"; rc=0
  if [ "$kind" = claude ]; then
    if [ -f "$sf" ]; then args=(--resume "$(cat "$sf")"); new=0
    else id="$(newuuid)"; args=(--session-id "$id"); new=1; fi
    : > "$LIVE"; S_ACT=""; S_ACT_AT=""; STALLED_AT=""
    ( cd "$cwd" && export CLAUDE_CONFIG_DIR="$dir" BRIDGE_NO_HOOK=1 BRIDGE_NAME="$name"; if [ "$COMPACT_AT" -gt 0 ]; then export CLAUDE_AUTOCOMPACT_PCT_OVERRIDE="$COMPACT_AT"; else unset CLAUDE_AUTOCOMPACT_PCT_OVERRIDE; fi; run_to "$TMO" claude -p --output-format stream-json --verbose "${MODEL_ARGS[@]}" "${CLAUDE_COMPACT_ARGS[@]}" "${CLAUDE_PERM[@]}" "${args[@]}" "$prompt" ) > "$LIVE" 2> "$LIVE.err" & supervise $! || rc=$?
    # the reply is the final "result" event; a rejected rate-limit event tells when the limit resets
    iserr="$(jq -r 'select(.type=="result")|.is_error' "$LIVE" 2>/dev/null | tail -1)"; [ "$iserr" = true ] && [ "$rc" = 0 ] && rc=1
    RESET_AT="$(jq -r 'select(.type=="rate_limit_event")|.rate_limit_info|select(.status=="rejected")|.resetsAt' "$LIVE" 2>/dev/null | tail -1)"
    jq -r 'select(.type=="result")|.result // empty' "$LIVE" 2>/dev/null > "$tmp"
    [ -s "$tmp" ] || { cat "$LIVE.err"; tail -c 2000 "$LIVE"; } > "$tmp" 2>/dev/null
    [ "$new" = 1 ] && [ "$rc" = 0 ] && echo "$id" > "$sf"
  elif [ "$kind" = codex ]; then
    out="$(mktemp)"; : > "$LIVE"; S_ACT=""; S_ACT_AT=""; STALLED_AT=""
    if [ -f "$sf" ]; then
      ( cd "$cwd" && BRIDGE_NO_HOOK=1 BRIDGE_NAME="$name" CODEX_HOME="$dir" run_to "$TMO" codex exec resume --json "${MODEL_ARGS[@]}" "${CODEX_PERM_RES[@]}" --skip-git-repo-check -o "$out" "$(cat "$sf")" "$prompt" < /dev/null ) > "$LIVE" 2> "$LIVE.err" & supervise $! || rc=$?
    else
      ( cd "$cwd" && BRIDGE_NO_HOOK=1 BRIDGE_NAME="$name" CODEX_HOME="$dir" run_to "$TMO" codex exec --json --skip-git-repo-check "${MODEL_ARGS[@]}" "${CODEX_PERM_NEW[@]}" -o "$out" "$prompt" < /dev/null ) > "$LIVE" 2> "$LIVE.err" & supervise $! || rc=$?
      id="$(jq -r 'select(.type=="thread.started")|.thread_id' "$LIVE" 2>/dev/null | head -1)"
      [ "$rc" = 0 ] && [ -n "$id" ] && echo "$id" > "$sf"
    fi
    errs="$(jq -r '(select(.type=="error")|.message), (select(.type=="turn.failed")|.error.message)' "$LIVE" 2>/dev/null | tr '\n' ' ')"
    [ -n "$errs" ] && [ "$rc" = 0 ] && ! [ -s "$out" ] && rc=1
    cat "$out" > "$tmp" 2>/dev/null; [ -s "$tmp" ] || { printf '%s\n' "$errs"; cat "$LIVE.err"; } | tail -c 2000 > "$tmp"; rm -f "$out"
  else
    : > "$LIVE"; S_ACT=""; S_ACT_AT=""; STALLED_AT=""
    session_args=(); [ -f "$sf" ] && session_args=(--resume-id "$(cat "$sf")")
    trust_args=(--trust-all-tools); { [ "$BYPASS" = 0 ] || [ "$BYPASS" = safe ]; } && trust_args=(--trust-tools=fs_read,grep,glob,code,introspect)
    (
      cd "$cwd" || exit 1
      settings_dir="$cwd/.kiro/settings"; settings_file="$settings_dir/cli.json"; kiro_dir="$cwd/.kiro"
      settings_dir_existed=0; kiro_dir_existed=0; [ -d "$settings_dir" ] && settings_dir_existed=1; [ -d "$kiro_dir" ] && kiro_dir_existed=1
      settings_backup=""; settings_existed=0; settings_link=0
      if [ -L "$settings_file" ]; then settings_link=1
      elif [ -f "$settings_file" ]; then settings_backup="$(mktemp)"; if [ -n "$settings_backup" ] && cp -p "$settings_file" "$settings_backup"; then settings_existed=1; else settings_link=1; settings_backup=""; fi; fi
      cleanup_kiro_settings() {
        if [ "$settings_link" = 0 ]; then
          if [ "$settings_existed" = 1 ]; then cp -p "$settings_backup" "$settings_file"
          else rm -f "$settings_file"; [ "$settings_dir_existed" = 1 ] || rmdir "$settings_dir" 2>/dev/null || true; [ "$kiro_dir_existed" = 1 ] || rmdir "$kiro_dir" 2>/dev/null || true; fi
        fi
        [ -z "$settings_backup" ] || rm -f "$settings_backup"
      }
      trap cleanup_kiro_settings EXIT
      if [ "$settings_link" = 0 ]; then
        mkdir -p "$settings_dir"
        settings_ok=1
        if [ "$COMPACT_AT" -gt 0 ]; then
          kiro-cli settings chat.disableAutoCompaction false --workspace >/dev/null 2>&1 || settings_ok=0
          kiro-cli settings compaction.autoCompactionThreshold "$COMPACT_AT" --workspace >/dev/null 2>&1 || settings_ok=0
        else kiro-cli settings chat.disableAutoCompaction true --workspace >/dev/null 2>&1 || settings_ok=0; fi
        [ "$settings_ok" = 1 ] && log "native Kiro auto-compact threshold=${COMPACT_AT}% for this order" || log "Kiro workspace compaction setting unavailable; using saved/default behavior"
      else log "Kiro workspace compaction override skipped for linked settings file"; fi
      BRIDGE_NO_HOOK=1 BRIDGE_NAME="$name" run_to "$TMO" kiro-cli chat --no-interactive --trust-workspace "${trust_args[@]}" --output-format stream-json "${MODEL_ARGS[@]}" "${session_args[@]}" "$prompt" < /dev/null
    ) > "$LIVE" 2> "$LIVE.err" & supervise $! || rc=$?
    status="$(jq -r 'select(.type=="runFinished")|.data.status // empty' "$LIVE" 2>/dev/null | tail -1)"
    { [ -n "$status" ] && [ "$status" != success ]; } && [ "$rc" = 0 ] && rc=1
    "$(dirname "$0")/bridge-kiro-response" "$LIVE" > "$tmp"
    [ -s "$tmp" ] || { cat "$LIVE.err"; tail -c 3000 "$LIVE"; } > "$tmp" 2>/dev/null
    id="$( (cd "$cwd" && kiro-cli chat --list-sessions --format json 2>/dev/null) | jq -r '[..|objects|select(.sessionId? and .updatedAt?)]|sort_by(.updatedAt)|last.sessionId // empty' 2>/dev/null)"
    [ -n "$id" ] || id="$(jq -r 'select(.type=="sessionUpdate")|.data.sessionId // empty' "$LIVE" 2>/dev/null | tail -1)"
    [ -n "$id" ] && [ "$rc" = 0 ] && echo "$id" > "$sf"
    RESET_AT=""
  fi
  res="$(head -c 6000 "$tmp")"; rm -f "$tmp"
  verdict="$(classify "$rc" "$res")"
  case "$verdict" in
    limit)
      [ -n "${RESET_AT:-}" ] || RESET_AT="$(printf '%s' "$res" | grep -o '|[0-9]\{10\}' | head -1 | tr -d '|')"
      now=$(date +%s); if [ -n "$RESET_AT" ] && [ "$RESET_AT" -gt "$now" ] 2>/dev/null; then PAUSE_UNTIL=$RESET_AT; else PAUSE_UNTIL=$((now + LIMIT_PAUSE)); fi
      [ $PAUSE_UNTIL -gt $((now + 43200)) ] && PAUSE_UNTIL=$((now + 43200))
      res="LIMIT: the provider's usage/rate limit was hit. This worker pauses until $(date -d "@$PAUSE_UNTIL" +%H:%M 2>/dev/null || date -r "$PAUSE_UNTIL" +%H:%M) and keeps queued orders; resend or reassign if urgent. Output: $res"
      log "limit hit: paused until $PAUSE_UNTIL"
      if [ "$REASSIGN" = 1 ] && other="$(pick_worker)" && [ -n "$other" ]; then reassign "$other"; res="$res
Order reassigned to '$other' (idle); it will reply to you directly."; log "order reassigned to $other"; fi;;
    api) res="API ERROR: the provider or the account failed (code $rc). Output: $res";;
    timeout) res="TIMEOUT after ${TMO}s: $res";;
    error) res="ERROR (code $rc): $res";;
  esac
  case "$verdict" in limit|api|error|timeout) notify_desktop "$verdict: ${res:0:120}";; esac
  RESET_AT=""; S_ACT=""; S_ACT_AT=""; S_STATUS=idle; S_ORDER=""; S_END=$(date +%s); S_RC=$rc; S_KIND=$verdict; S_SINCE=$S_END; sw
  [ -n "$res" ] || res="(no output)"
  BRIDGE_NAME="$name" "$(dirname "$0")/bridge-send" "$from" "$res" >/dev/null
  echo "- $(date '+%F %T') from $from [$cwd] rc=$rc: $(printf '%s' "$body" | head -c 100 | tr '\n' ' ')" >> "$NOTES"
  log "replied to $from (rc=$rc)"
done
