#!/usr/bin/env bash
# bridge-kiro-usage <name> <cache-dir>: cached monthly quota fields as TSV.
# A cold Kiro /usage query runs in the background so dashboard polls stay fast.
set -u
name="${1:?usage: bridge-kiro-usage <name> <cache-dir>}"
cache_dir="${2:?usage: bridge-kiro-usage <name> <cache-dir>}"
mode="${3:-}"
lock="${4:-$cache_dir/$name.kiro.json.lock}"
cli="${BRIDGE_KIRO_CLI:-$(command -v kiro-cli 2>/dev/null || true)}"
cache="$cache_dir/$name.kiro.json"
now() { date +%s; }
fresh() { [ -s "$cache" ] && [ "$(jq -r '.fetched_at // 0' "$cache" 2>/dev/null)" -gt 0 ] && [ $(( $(now) - $(jq -r '.fetched_at // 0' "$cache" 2>/dev/null) )) -lt 300 ]; }
recent_try() { [ -s "$cache_dir/$name.kiro.last_try" ] && [ $(( $(now) - $(cat "$cache_dir/$name.kiro.last_try" 2>/dev/null || echo 0) )) -lt 300 ]; }
print_cache() {
  if [ -s "$cache" ]; then
    jq -r '[.percent // "-",.resets_at // "-",.credits_used // "-",.credits_total // "-",.plan // "-",(($now - (.fetched_at // $now))|tostring)]|@tsv' --argjson now "$(now)" "$cache" 2>/dev/null || printf '%s\n' $'-\t-\t-\t-\t-\t-'
  else printf '%s\n' $'-\t-\t-\t-\t-\t-'; fi
}
if [ "$mode" != --fetch ]; then
  fresh && { print_cache; exit 0; }
  mkdir -p "$cache_dir"
  if [ -n "$cli" ] && ! recent_try && mkdir "$lock" 2>/dev/null; then
    now > "$cache_dir/$name.kiro.last_try"
    nohup "$0" "$name" "$cache_dir" --fetch "$lock" >/dev/null 2>&1 </dev/null &
    echo "$!" > "$lock/pid"
  elif [ -d "$lock" ] && [ -s "$lock/pid" ] && ! kill -0 "$(cat "$lock/pid")" 2>/dev/null; then
    rmdir "$lock" 2>/dev/null || true
  fi
  print_cache
  exit 0
fi
finish() { rm -f "$lock/pid"; rmdir "$lock" 2>/dev/null || true; }
trap finish EXIT INT TERM
usage_cwd="${BRIDGE_KIRO_USAGE_CWD:-$cache_dir/usage-cwd-$name}"
mkdir -p "$usage_cwd"; cd "$usage_cwd" || exit 1
before="$("$cli" chat --list-sessions --format json 2>/dev/null | jq -r '[..|objects|.sessionId? // empty]|unique|.[]' 2>/dev/null | sort)"
if command -v timeout >/dev/null 2>&1; then output="$(timeout 35 "$cli" chat --no-interactive '/usage' 2>/dev/null || true)"
elif command -v gtimeout >/dev/null 2>&1; then output="$(gtimeout 35 "$cli" chat --no-interactive '/usage' 2>/dev/null || true)"
else output="$("$cli" chat --no-interactive '/usage' 2>/dev/null || true)"; fi
after="$("$cli" chat --list-sessions --format json 2>/dev/null | jq -r '[..|objects|.sessionId? // empty]|unique|.[]' 2>/dev/null | sort)"
new_ids="$(comm -13 <(printf '%s\n' "$before" | sed '/^$/d') <(printf '%s\n' "$after" | sed '/^$/d'))"
while IFS= read -r session; do [ -n "$session" ] && "$cli" chat --delete-session "$session" >/dev/null 2>&1 || true; done <<< "$new_ids"
reset="" plan="" used="" total="" percent=""
while IFS= read -r line; do
  if [[ "$line" =~ ^Estimated[[:space:]]Usage[[:space:]]\|[[:space:]]resets[[:space:]]on[[:space:]]([0-9]{4}-[0-9]{2}-[0-9]{2})[[:space:]]\|[[:space:]](.+)$ ]]; then reset="${BASH_REMATCH[1]}"; plan="${BASH_REMATCH[2]}"; fi
  if [[ "$line" =~ ^Credits[[:space:]]\(([0-9]+([.][0-9]+)?)[[:space:]]of[[:space:]]([0-9]+([.][0-9]+)?)[[:space:]]covered[[:space:]]in[[:space:]]plan\),[[:space:]]([0-9]+([.][0-9]+)?)%$ ]]; then used="${BASH_REMATCH[1]}"; total="${BASH_REMATCH[3]}"; percent="${BASH_REMATCH[5]}"; fi
done <<< "$output"
if [ -n "$reset" ] && [ -n "$plan" ] && [ -n "$percent" ]; then
  reset_at="$(date -d "$reset 00:00:00" +%s 2>/dev/null || date -j -f '%Y-%m-%d %H:%M:%S' "$reset 00:00:00" +%s 2>/dev/null || true)"
  if [[ "$reset_at" =~ ^[0-9]+$ ]]; then tmp="$cache.tmp.$$"; jq -n --argjson fetched_at "$(now)" --argjson resets_at "$reset_at" --argjson percent "$percent" --argjson credits_used "$used" --argjson credits_total "$total" --arg plan "$plan" '{fetched_at:$fetched_at,resets_at:$resets_at,percent:$percent,credits_used:$credits_used,credits_total:$credits_total,plan:$plan}' > "$tmp" && mv "$tmp" "$cache"; fi
fi
