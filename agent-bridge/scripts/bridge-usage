#!/usr/bin/env bash
# bridge-usage <name>: prints model, project, branch, ctx%, 5h%, week%, age, effort, resets, month%, month reset, session credits, model window, plan credits and plan.
# ("-" = unknown; *_reset are epoch seconds; month = provider monthly usage). Codex: read from its latest session file. Claude context is retained from its latest live log; Kiro quota is cached for five minutes. Antigravity, Cursor and Qwen have no quota data (tier normal) and their context is estimated from token usage.
B="${BRIDGE_DIR:-$HOME/.claude-bridge}"; name="${1:?usage: bridge-usage <name>}"
dir="$(awk -F= -v n="$name" '$2==n{print $1; exit}' "$B/names.conf" 2>/dev/null)"; [ -n "$dir" ] || exit 1
now=$(date +%s); model=""; cwd=""; ctx=""; h5=""; wk=""; at=""; eff=""; h5r=""; wkr=""; mo=""; mor=""; credits=""; ctxwin=""; plan_used=""; plan_total=""; plan=""
kind="$("$(dirname "$0")/bridge-provider" "$dir" 2>/dev/null || true)"
case "$kind" in
  codex)
    f="$(find "$dir/sessions" -name '*.jsonl' -type f -print0 2>/dev/null | xargs -0 ls -t 2>/dev/null | head -1)"
    if [ -n "$f" ]; then
      at="$(stat -c %Y "$f" 2>/dev/null || stat -f %m "$f" 2>/dev/null)"
      tail -n 400 "$f" > "${TMPDIR:-/tmp}/bu.$$"
      # model / effort / cwd come from the LAST turn_context of the whole file (a long session has them far above its last 400 lines)
      tc="$(grep '"type":"turn_context"' "$f" 2>/dev/null | tail -1)"
      model="$(printf '%s' "$tc" | jq -r '.payload.model // empty' 2>/dev/null)"
      cwd="$(printf '%s' "$tc" | jq -r '.payload.cwd // empty' 2>/dev/null)"
      eff="$(printf '%s' "$tc" | jq -r '.payload.effort // empty' 2>/dev/null)"
      [ -n "$cwd" ] || cwd="$(head -1 "$f" | jq -r '.payload.cwd // empty' 2>/dev/null)"
      # windows are told apart by length: <=10h = "5h", <=14 days = week, longer = month (Codex free/go plans have only a 30-day window)
      row="$(jq -r --argjson now "$now" 'select(.type=="event_msg" and .payload.type=="token_count" and .payload.rate_limits!=null)|
        ([.payload.rate_limits.primary,.payload.rate_limits.secondary]|map(select(.!=null))) as $w | select(($w|length)>0) |
        def p(f): ($w|map(select(.window_minutes|f))|first) as $x | if $x==null then ["",""] else [(if $x.resets_at<$now then 0 else ($x.used_percent|floor) end), $x.resets_at] end;
        [ (if .payload.info.model_context_window then ((.payload.info.last_token_usage.total_tokens*100/.payload.info.model_context_window)|floor) else "" end) ]
        + p(.<=600) + p(.>600 and .<=20160) + p(.>20160) | @tsv' "${TMPDIR:-/tmp}/bu.$$" 2>/dev/null | tail -1)"
      rm -f "${TMPDIR:-/tmp}/bu.$$"; ctx="$(printf '%s' "$row" | cut -f1)"; h5="$(printf '%s' "$row" | cut -f2)"; h5r="$(printf '%s' "$row" | cut -f3)"
      wk="$(printf '%s' "$row" | cut -f4)"; wkr="$(printf '%s' "$row" | cut -f5)"; mo="$(printf '%s' "$row" | cut -f6)"; mor="$(printf '%s' "$row" | cut -f7)"
      ctxwin="$(jq -r 'select(.type=="event_msg" and .payload.type=="token_count")|.payload.info.model_context_window // empty' "$f" 2>/dev/null | tail -1)"
    fi;;
  claude)
    # candidates, newest wins: (a) JSON saved by bridge-statusline, (b) the status line cache some setups keep per session
    # (~/.cache/lordos/claude/<session>.json, matched by its transcript path), (c) the worker's live stream-json log
    f="$B/logs/$name.live"; [ "$B/logs/$name.probe" -nt "$f" ] && f="$B/logs/$name.probe"   # probe = `agent refresh`
    u="$B/usage/$name.json"; cache="${BRIDGE_STATUS_CACHE:-$HOME/.cache/lordos/claude}"
    if [ -d "$cache" ]; then
      c="$(for x in "$cache"/*.json; do [ -f "$x" ] && jq -r --arg d "$dir/projects/" 'select((.transcript_path // "")|startswith($d))|input_filename' "$x" 2>/dev/null; done | xargs -r ls -t 2>/dev/null | head -1)"
      [ -n "$c" ] && { [ ! -s "$u" ] || [ "$c" -nt "$u" ]; } && u="$c"
    fi
    if [ -s "$u" ] && { [ ! -s "$f" ] || [ "$u" -nt "$f" ]; }; then
      at="$(stat -c %Y "$u" 2>/dev/null || stat -f %m "$u" 2>/dev/null)"
      IFS=$'\t' read -r model eff cwd ctx h5 wk h5r wkr < <(jq -r 'def num: if . == null then "-" else floor|tostring end; def str: if . == null then "-" else tostring end; [(.model.display_name|str),(.effort.level|str),(.workspace.current_dir // .cwd|str),(.context_window.used_percentage|num),(.rate_limits.five_hour.used_percentage|num),(.rate_limits.seven_day.used_percentage|num),(.rate_limits.five_hour.resets_at|str),(.rate_limits.seven_day.resets_at|str)]|@tsv' "$u" 2>/dev/null)
    elif [ -s "$f" ]; then
      at="$(stat -c %Y "$f" 2>/dev/null || stat -f %m "$f" 2>/dev/null)"
      # Fold the live transcript in one jq process; separate jq|tail|cut pipelines repeatedly parsed multi-megabyte logs.
      row="$(jq -sr '[.[]|select(.type=="system" and .subtype=="init")] as $init | [.[]|select(.type=="rate_limit_event")] as $rates | [.[]|select(.type=="assistant" and .message.usage)] as $assistants | [.[]|select(.type=="result")] as $results | ($rates[-1].rate_limit_info.unifiedWindows // {}) as $windows | ($assistants[-1].message.usage // {}) as $usage | (($results[-1].modelUsage // {})|to_entries[0].value.contextWindow // "-") as $window | [($init[-1].model // (($results[-1].modelUsage // {})|keys[0]) // "-"),($init[-1].cwd // "-"),(if $windows.five_hour.utilization == null then "-" else (($windows.five_hour.utilization*100)|floor|tostring) end),(if $windows.seven_day.utilization == null then "-" else (($windows.seven_day.utilization*100)|floor|tostring) end),($windows.five_hour.resetsAt // "-"),($windows.seven_day.resetsAt // "-"),(if ($assistants|length)>0 then ((($usage.input_tokens // 0)+($usage.cache_read_input_tokens // 0)+($usage.cache_creation_input_tokens // 0))|tostring) else "-" end),($window|tostring)]|@tsv' "$f" 2>/dev/null)"
      IFS=$'\t' read -r model cwd h5 wk h5r wkr used win <<< "$row"
      for v in model cwd h5 wk h5r wkr used win; do [ "${!v}" = - ] && printf -v "$v" ''; done
      win_file="$B/usage/$name.window"; mkdir -p "$B/usage"
      if [[ "$win" =~ ^[0-9]+$ ]] && [ "$win" -gt 0 ]; then
        jq -n --arg model "$model" --argjson window "$win" '{model:$model,window:$window}' > "$win_file.tmp.$$" && mv "$win_file.tmp.$$" "$win_file"
      else
        saved_model="$(jq -r '.model // empty' "$win_file" 2>/dev/null)"; saved_window="$(jq -r '.window // empty' "$win_file" 2>/dev/null)"
        [ -n "$saved_window" ] && { [ -z "$model" ] || [ "$saved_model" = "$model" ]; } && win="$saved_window"
        if [ -z "$win" ]; then case "$model" in claude-sonnet-5-5|claude-opus-5-5) win=1000000;; esac; fi
      fi
      if [[ "$win" =~ ^[0-9]+$ ]] && [ "$win" -gt 0 ]; then
        jq -n --arg model "$model" --argjson window "$win" '{model:$model,window:$window}' > "$win_file.tmp.$$" && mv "$win_file.tmp.$$" "$win_file"
      fi
      ctxwin="$win"
      [ -n "$used" ] && [[ "$win" =~ ^[0-9]+$ ]] && [ "$win" -gt 0 ] && ctx=$((used * 100 / win))
    fi;;
  antigravity) # agy exposes no quota or context meter: model/effort are what the admin set, context is estimated from the runner's live log
    live="$B/logs/$name.live"; model="$(cat "$B/models/$name" 2>/dev/null)"; [ -n "$model" ] || model="default"; eff="$(cat "$B/effort/$name" 2>/dev/null)"
    sf="$(ls -t "$B/sessions/$name"/* 2>/dev/null | while IFS= read -r f; do case "$f" in *.cwd) continue;; esac; [ -f "$f" ] && { printf '%s\n' "$f"; break; }; done)"
    [ -n "$sf" ] && cwd="$(cat "$sf.cwd" 2>/dev/null)"
    if [ -s "$live" ]; then
      at="$(stat -c %Y "$live" 2>/dev/null || stat -f %m "$live" 2>/dev/null)"
      case "$model" in claude*) ctxwin=200000;; gpt-oss*) ctxwin=128000;; *) ctxwin=1000000;; esac; [[ "${BRIDGE_AGY_WINDOW:-}" =~ ^[0-9]+$ ]] && ctxwin="$BRIDGE_AGY_WINDOW"
      used="$(jq -r 'select(.event=="step_update")|.step_update|select(.step_type=="agent_response" and .state=="DONE" and .usage!=null)|(.usage.input_tokens + .usage.cache_read_tokens + .usage.output_tokens)' "$live" 2>/dev/null | tail -1)"
      [[ "$used" =~ ^[0-9]+$ ]] && ctx=$((used * 100 / ctxwin))
    fi;;
  cursor|qwen) # no quota or context meter in either CLI: model is what the admin set, context is estimated from the runner's live log
    live="$B/logs/$name.live"; model="$(cat "$B/models/$name" 2>/dev/null)"; [ -n "$model" ] || model="default"
    sf="$(ls -t "$B/sessions/$name"/* 2>/dev/null | while IFS= read -r f; do case "$f" in *.cwd) continue;; esac; [ -f "$f" ] && { printf '%s\n' "$f"; break; }; done)"
    [ -n "$sf" ] && cwd="$(cat "$sf.cwd" 2>/dev/null)"
    if [ -s "$live" ]; then
      at="$(stat -c %Y "$live" 2>/dev/null || stat -f %m "$live" 2>/dev/null)"
      if [ "$kind" = qwen ]; then ctxwin=256000; [[ "${BRIDGE_QWEN_WINDOW:-}" =~ ^[0-9]+$ ]] && ctxwin="$BRIDGE_QWEN_WINDOW"
        used="$(jq -r 'select(.type=="assistant")|.message.usage|((.input_tokens // 0)+(.cache_read_input_tokens // 0))' "$live" 2>/dev/null | tail -1)"
      else case "$model" in *1m*|*sol*|*fable*|*opus-5*) ctxwin=1000000;; *) ctxwin=200000;; esac; [[ "${BRIDGE_CURSOR_WINDOW:-}" =~ ^[0-9]+$ ]] && ctxwin="$BRIDGE_CURSOR_WINDOW"
        used="$(jq -r 'select(.type=="result")|.usage|((.inputTokens // 0)+(.cacheReadTokens // 0))' "$live" 2>/dev/null | tail -1)"; fi
      [[ "$used" =~ ^[0-9]+$ ]] && ctx=$((used * 100 / ctxwin))
    fi;;
  kiro)
    sess_file=""; sess="$(find "$B/sessions/$name" -maxdepth 1 -type f ! -name '*.cwd' -print 2>/dev/null | head -1)"; sess="$(cat "$sess" 2>/dev/null)"
    if [ -n "$sess" ]; then sess_file="$(find "$dir/sessions" -path "*/$sess/session.json" -type f 2>/dev/null | head -1)"; fi
    if [ -n "$sess_file" ]; then
      root="${sess_file%/session.json}"; f="$root/messages.jsonl"
      at="$(stat -c %Y "$f" 2>/dev/null || stat -f %m "$f" 2>/dev/null)"
      cwd="$(jq -r '.workspacePaths[0] // .rootPaths[0] // empty' "$sess_file" 2>/dev/null)"
      model="$(jq -r '.modelId // empty' "$sess_file" 2>/dev/null)"
      eff="$(cat "$B/effort/$name" 2>/dev/null)"
      ctx="$(jq -r 'select(.payload.type=="session_metadata" and .payload.key=="contextUsage")|.payload.value.usagePercentage // empty' "$f" 2>/dev/null | tail -1 | awk '{printf "%d", $1+0.5}')"
      credits="$(jq -sr '[.[]|select(.payload.type=="usage_summary")|.payload.promptTurnSummaries[]?|select(.unit=="credit")|.usage|select(type=="number")]|add // empty' "$f" 2>/dev/null)"
    fi
    quota="$("$(dirname "$0")/bridge-kiro-usage" "$name" "$B/usage" 2>/dev/null)"
    IFS=$'\t' read -r mo mor plan_used plan_total plan _ <<< "$quota";;
esac
if [ "$kind" = claude ]; then
  ctx_cache="$B/usage/$name.last"; mkdir -p "$B/usage"
  if [[ "$ctx" =~ ^[0-9]+$ ]]; then
    jq -n --argjson context "$ctx" --argjson updated_at "${at:-$now}" '{context:$context,updated_at:$updated_at}' > "$ctx_cache.tmp.$$" && mv "$ctx_cache.tmp.$$" "$ctx_cache"
  elif [ -s "$ctx_cache" ]; then ctx="$(jq -r '.context // empty' "$ctx_cache" 2>/dev/null)"; at="$(jq -r '.updated_at // empty' "$ctx_cache" 2>/dev/null)"; fi
fi
for v in model cwd ctx h5 wk at eff h5r wkr mo mor ctxwin plan_used plan_total plan; do [ "${!v}" = - ] && printf -v "$v" ''; done
proj=""; br=""; if [ "$cwd" = "$HOME" ]; then proj="~"; elif [ -n "$cwd" ] && [ -d "$cwd" ]; then proj="$(basename "$cwd")"; br="$(git -C "$cwd" rev-parse --abbrev-ref HEAD 2>/dev/null)"; elif [ -n "$cwd" ]; then proj="$(basename "$cwd")"; fi
age=""; [ -n "$at" ] && age=$((now - at))
# a window whose reset moment already passed has been renewed: 0% used, reset time unknown until fresh data arrives
for w in h5 wk mo; do r="${w}r"; [ "$w" = mo ] && r=mor; rv="${!r}"
  if [ -n "$rv" ] && [ "$rv" -le "$now" ] 2>/dev/null; then printf -v "$w" 0; printf -v "$r" ''; fi; done
# "-" stands for unknown so tab-splitting (which collapses empty fields) keeps the columns aligned
printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "${model:--}" "${proj:--}" "${br:--}" "${ctx:--}" "${h5:--}" "${wk:--}" "${age:--}" "${eff:--}" "${h5r:--}" "${wkr:--}" "${mo:--}" "${mor:--}" "${credits:--}" "${ctxwin:--}" "${plan_used:--}" "${plan_total:--}" "${plan:--}"
