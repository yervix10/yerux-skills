#!/usr/bin/env bash
# agent ping <target> | agent <target> <message...> | agent list | agent inbox | agent listen | agent up/down/status/logs/reset
D="$(dirname "$0")"; R="${BRIDGE_DIR:-$HOME/.claude-bridge}"; me="$("$D/bridge-whoami")"
case "$1" in
  ping) [ -n "$2" ] || { echo "usage: agent ping <target>" >&2; exit 1; }
        "$D/bridge-send" "$2" "ping from $me ($(date +%T))" ;;
  admin) shift; exec "$D/admin" "$@";;
  up) shift; names=("$@"); [ "$1" = all ] && names=($(awk -F= '{print $2}' "$R/names.conf")); 
      for n in "${names[@]}"; do [ "$n" = "$me" ] && continue
        if [ -f "$R/runs/$n.pid" ] && kill -0 "$(cat "$R/runs/$n.pid")" 2>/dev/null; then echo "$n: already up"; continue; fi
        mkdir -p "$R/runs" "$R/logs"; if command -v setsid >/dev/null 2>&1; then setsid nohup "$D/bridge-runner" "$n" >/dev/null 2>&1 < /dev/null & else nohup "$D/bridge-runner" "$n" >/dev/null 2>&1 < /dev/null & fi; echo $! > "$R/runs/$n.pid"; echo "$n: up (pid $!)"; done;;
  down) shift; names=("$@"); [ "$1" = all ] && names=($(ls "$R/runs" 2>/dev/null | sed 's/\.pid$//'))
      for n in "${names[@]}"; do p="$(cat "$R/runs/$n.pid" 2>/dev/null)"; [ -n "$p" ] && kill "$p" 2>/dev/null && echo "$n: stopped" || echo "$n: was not up"; rm -f "$R/runs/$n.pid"; done;;
  status) now=$(date +%s); for n in $(awk -F= '{print $2}' "$R/names.conf"); do
      if [ -f "$R/runs/$n.pid" ] && kill -0 "$(cat "$R/runs/$n.pid")" 2>/dev/null; then
        sf="$R/runs/$n.state"; g() { sed -n "s/^$1=//p" "$sf" 2>/dev/null | head -1; }
        st="$(g status)"; since="$(g since)"; beat="$(g beat)"; line="$n: UP"
        if [ -z "$st" ]; then line="$line  (no state yet: restart it with agent down/up $n)"
        elif [ -n "$beat" ] && [ $((now - beat)) -gt 120 ]; then line="$line  NO HEARTBEAT for $(( (now - beat) / 60 )) min: the runner looks stuck (agent down $n; agent up $n)"
        elif [ "$st" = limited ]; then pu="$(g pause_until)"; line="$line  LIMITED, paused until $(date -d "@$pu" +%H:%M 2>/dev/null || date -r "$pu" +%H:%M)"
        elif [ "$st" = working ]; then el=$((now - since)); line="$line  WORKING $([ $el -ge 120 ] && echo "$((el / 60)) min" || echo "${el}s")  ($(g order))"
          ac="$(g activity)"; aa="$(g activity_at)"; [ -n "$ac" ] && line="$line  now: $ac [$(( (now - aa) ))s ago]"
        else line="$line  idle"; lk="$(g last_kind)"; le="$(g last_end)"
          [ -n "$lk" ] && line="$line · last order: $lk ($(date -d "@$le" +%H:%M 2>/dev/null || date -r "$le" +%H:%M 2>/dev/null))"; fi
        echo "$line"
      else echo "$n: -"; fi; done;;
  wt) shift; sub="${1:-list}"; wn="$2"; root="$(git rev-parse --show-toplevel 2>/dev/null)" || { echo "agent wt: run it inside a git project" >&2; exit 1; }
      root="$(cd "$root" && cd "$(git rev-parse --git-common-dir)/.." && pwd)"; yes=0; for a in "$@"; do [ "$a" = --yes ] && yes=1; done
      case "$sub" in
        list) found=0; for d in "$root"/.worktrees/*/; do [ -d "$d" ] || continue; found=1; w="$(basename "$d")"; br="$(git -C "$d" rev-parse --abbrev-ref HEAD 2>/dev/null)"
            base="$(git -C "$root" rev-parse --abbrev-ref HEAD)"; ahead="$(git -C "$root" rev-list --count "$base..$br" 2>/dev/null)"; dirty="$(git -C "$d" status --short | wc -l | tr -d ' ')"
            echo "$w: branch $br, $ahead commit(s) ahead of $base, $dirty uncommitted file(s)"; done; [ $found = 0 ] && echo "no worktrees in $root/.worktrees";;
        diff) [ -n "$wn" ] || { echo "usage: agent wt diff <name>" >&2; exit 1; }; git -C "$root" diff --stat "HEAD...mejora/$wn";;
        merge) [ -n "$wn" ] || { echo "usage: agent wt merge <name> [--yes]" >&2; exit 1; }; d="$root/.worktrees/$wn"
            [ -d "$d" ] || { echo "no worktree for $wn" >&2; exit 1; }
            [ -z "$(git -C "$d" status --short)" ] || { echo "$wn has uncommitted changes; ask it to commit first" >&2; exit 1; }
            [ -z "$(git -C "$root" status --short --untracked-files=no)" ] || { echo "the main checkout has uncommitted changes; commit or stash them first" >&2; exit 1; }
            base="$(git -C "$root" rev-parse --abbrev-ref HEAD)"; echo "would merge mejora/$wn into $base:"; git -C "$root" log --oneline "$base..mejora/$wn"
            [ $yes = 1 ] || { echo "(add --yes to merge)"; exit 0; }; git -C "$root" merge --no-ff -m "Merge mejora/$wn" "mejora/$wn";;
        clean) [ -n "$wn" ] || { echo "usage: agent wt clean <name> [--yes]" >&2; exit 1; }; d="$root/.worktrees/$wn"
            [ $yes = 1 ] || { echo "would remove $d and delete branch mejora/$wn if it is merged (add --yes)"; exit 0; }
            git -C "$root" worktree remove "$d" && git -C "$root" branch -d "mejora/$wn";;
        *) echo "agent wt list | diff <name> | merge <name> [--yes] | clean <name> [--yes]" >&2; exit 1;;
      esac;;
  refresh) shift; names=("$@"); { [ -z "$1" ] || [ "$1" = all ]; } && names=($(awk -F= '{print $2}' "$R/names.conf"))
      # one tiny request per Claude account so the dashboard has fresh model / context / 5h / weekly numbers (costs a few tokens)
      for n in "${names[@]}"; do dir="$(awk -F= -v n="$n" '$2==n{print $1; exit}' "$R/names.conf")"
        case "$(basename "$dir")" in .claude*) mkdir -p "$R/logs"
          ( cd "$HOME" && BRIDGE_NO_HOOK=1 BRIDGE_NAME="$n" CLAUDE_CONFIG_DIR="$dir" claude -p --no-session-persistence --output-format stream-json --verbose "Reply with exactly: ok" > "$R/logs/$n.probe.tmp" 2>/dev/null ) && mv "$R/logs/$n.probe.tmp" "$R/logs/$n.probe" && echo "$n: refreshed" || { rm -f "$R/logs/$n.probe.tmp"; echo "$n: failed (is claude logged in there?)"; };;
          *) echo "$n: Codex data comes from its sessions, nothing to refresh";; esac; done;;
  dashboard) # live view (terminal) or --once: a single plain snapshot (what the admin's /dashboard prints)
      once=0; [ "$2" = --once ] && once=1
      if [ $once = 0 ]; then trap 'printf "\033[?25h"; exit 0' INT TERM; printf '\033[?25l'; fi
      col() { [ $once = 0 ] && printf '\033[%sm' "$1"; return 0; }
      pct() { [ -z "$1" ] && { col 2; printf '–'; col 0; return; }; c=32; [ "$1" -ge 60 ] && c=33; [ "$1" -ge 85 ] && c=31; col $c; printf '%s%%' "$1"; col 0; }
      while :; do
        if [ $once = 0 ]; then printf '\033[H\033[2J'; printf '\033[1magent-bridge\033[0m  %s   \033[2m(Ctrl+C to exit)\033[0m\n\n' "$(date +%T)"; else echo "agent-bridge  $(date +%T)"; echo; fi
        st="$("$0" status)"
        for n in $(awk -F= '{print $2}' "$R/names.conf"); do
          IFS=$'\t' read -r model proj br ctx h5 wk age eff < <("$D/bridge-usage" "$n" 2>/dev/null)
          for v in model proj br ctx h5 wk age eff; do [ "${!v}" = - ] && printf -v "$v" ''; done
          want="$(cat "$R/models/$n" 2>/dev/null)"; weff="$(cat "$R/effort/$n" 2>/dev/null)"
          state="$(printf '%s\n' "$st" | sed -n "s/^$n: *//p" | head -1)"
          col 1; printf '%-9s' "$n"; col 0; printf ' %s' "${model:-–}"; [ -n "$eff" ] && printf ' · %s' "$eff"; { [ -n "$want" ] || [ -n "$weff" ]; } && printf ' (set: %s)' "$(printf '%s %s' "${want:-}" "${weff:+effort $weff}" | sed 's/^ //; s/ $//')"
          printf ' | %s | %s | ctx ' "${proj:-–}" "${br:-–}"; pct "$ctx"; printf ' | 5h '; pct "$h5"; printf ' | sem '; pct "$wk"
          [ -n "$age" ] && [ "$age" -gt 600 ] && { col 2; printf ' (data %s min old)' $((age / 60)); col 0; }
          printf '\n          '; col 2; printf '%s' "$state"; col 0; printf '\n'; done
        [ $once = 1 ] && break; sleep 2; done;;
  model|effort) cmd="$1"; shift; n="$1"; v="$2"; f="$R/models"; [ "$cmd" = effort ] && f="$R/effort"
      if [ -z "$n" ]; then for w in $(awk -F= '{print $2}' "$R/names.conf"); do echo "$w: model $(cat "$R/models/$w" 2>/dev/null || echo default), effort $(cat "$R/effort/$w" 2>/dev/null || echo default)"; done; exit 0; fi
      [ "$me" = "$(cat "$R/admin" 2>/dev/null)" ] || { echo "only the admin can change a worker's $cmd (you are $me)" >&2; exit 1; }
      dir="$(awk -F= -v n="$n" '$2==n{print $1; exit}' "$R/names.conf")"; [ -n "$dir" ] || { echo "unknown worker: $n" >&2; exit 1; }
      [ -n "$v" ] || { echo "usage: agent $cmd <worker> <$([ "$cmd" = effort ] && echo level || echo model)|default>   e.g. agent model agent-2 claude-opus-5-5 high" >&2; exit 1; }
      setone() { local file="$1" val="$2" what="$3"
        if [ "$val" = default ]; then rm -f "$file"; echo "$n: $what back to its default (applies from its next order)"; return 0; fi
        if [ "$what" = effort ]; then case "$(basename "$dir")" in .claude*) levels="low medium high xhigh max";; *) levels="none minimal low medium high xhigh";; esac
          case " $levels " in *" $val "*) ;; *) echo "invalid effort for $(basename "$dir" | sed 's/^\.\(claude\|codex\).*/\1/'): use one of $levels, or default" >&2; return 1;; esac
        else [[ "$val" =~ ^[][A-Za-z0-9._:/-]+$ ]] || { echo "invalid model name" >&2; return 1; }; fi
        mkdir -p "$(dirname "$file")"; printf '%s' "$val" > "$file"; echo "$n: $what set to $val (applies from its next order)"; }
      if [ "$cmd" = model ]; then setone "$R/models/$n" "$v" model || exit 1; [ -n "$3" ] && { setone "$R/effort/$n" "$3" effort || exit 1; }
      else setone "$R/effort/$n" "$v" effort || exit 1; fi;;
  logs) [ -f "$R/runs/$2.state" ] && sed -n 's/^status=/status: /p;s/^order=/order: /p;s/^activity=/doing: /p;s/^last_kind=/last result: /p' "$R/runs/$2.state"; tail -n "${3:-30}" "$R/logs/$2.log";;
  reset) rm -rf "$R/sessions/$2" && echo "memory of $2 cleared";;
  list) "$D/bridge-send" --list ;;
  inbox) ls "${BRIDGE_DIR:-$HOME/.claude-bridge}/inbox/$me" 2>/dev/null | sed 's/^/pending: /'; echo "(end)" ;;
  listen) exec "$D/bridge-wait" ;;
  ""|-h|--help) echo "agent ping <target> | agent <target> <message> | agent all <message> | agent list | agent inbox | agent listen | agent up|down <name|all> | agent status | agent dashboard [--once] | agent model <worker> <model|default> [effort] | agent effort <worker> <level|default> | agent refresh [name|all] | agent logs <name> | agent reset <name> | agent wt list|diff|merge|clean <name> | agent admin [who|release]" ;;
  *) to="$1"; shift; "$D/bridge-send" "$to" "$@" ;;
esac
